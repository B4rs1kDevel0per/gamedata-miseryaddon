#include "eatable_objects.ltx"
#include "hud_objects.ltx"

[antirad]:booster
$spawn 				= "food and drugs\antirad"
visual				= dynamics\devices\dev_antirad\dev_antirad.ogf
inv_name			= st_antirad
inv_name_short		= st_antirad
description			= st_antirad_descr
inv_weight			= 0.05

inv_grid_width		= 1
inv_grid_height		= 1
inv_grid_x			= 0
inv_grid_y			= 2
cost				= 1360

use_sound			= $silent

hud = antirad_hud_model
trash_object = antirad_trash

change_outfit_svoboda_exo_outfit = antirad_exo
change_outfit_exo_outfit = antirad_exo

[antirad_exo]
hud = antirad_exo_hud_model

[antirad_trash]:gwr_base_trash
visual                        = dynamics\devices\dev_antirad\dev_antirad_trash.ogf

;направление, в котором предмет отбрасывается
throw_dir = right
;смещение точки спавна относительно камеры
throw_offset_y = -0.6	//вверх-вниз
throw_offset_x = -0.2	//вперед-назад
throw_offset_z = -0.6	//положительные - в сторону броска, отрицательное - в противоположную

throw_impulse_y = -90
throw_impulse_z = 180

