#include "hud_objects.ltx"
#include "eatable_objects.ltx"

[vodka2]:booster
;***********************************************************
hud = vodka2_hud_model
helm_prohibited = false; true
full_outfit_prohibited = false ;true

base_object = vodka2 ;показывает, какая секция является базовой для "одинаковых" предметов разной степени целостности
uses_count = 3	    ;Сколько раз предмет можно использовать

;При первом использовании всегда съедается базовый предмет
using_2 = vodka2_2	;Секция предмета, который будет заспавнен после первого использования, и который отвечает за второе использование
using_3 = vodka2_3	;Аналогично для второго использования
;************************************************************


$spawn 				= "food and drugs\vodka2"
cform				= skeleton
visual				= dynamics\devices\dev_vodka\dev_vodka2.ogf
description			= st_vodka2_descr

inv_name			= st_vodka2
inv_name_short		= st_vodka2
inv_weight			= 1.454

inv_grid_width		= 1
inv_grid_height		= 1
inv_grid_x			= 21
inv_grid_y			= 5
cost				= 3516

attach_angle_offset		= 0.000000, 0.000000, 0.000000
attach_position_offset	= 0.087266, -0.078540, 0.052360
attach_bone_name		= bip01_r_hand
auto_attach				= false

bone_name				= bip01_r_hand
position_offset			 = 0.0,0.0,0.0
angle_offset			 = 1.570790,1.570790,3.92699

break_particles		= destroy_fx\destroy_bottle
break_sound			= material\bottle\collide\bottle_break_1

boost_time				= 0.0
boost_radiation_restore	= 0.00
eat_alcohol				= 0.0
eat_satiety				= 0.0

use_sound			= $silent ;interface\inv_vodka

repair_part_bonus		= 0.03

[vodka2_2]:vodka2
