#include "eatable_objects.ltx"
#include "hud_objects.ltx"


[medkit]:booster
$spawn 				= "food and drugs\medkit"
visual				= dynamics\devices\dev_aptechka\dev_aptechka_low.ogf
inv_name			= st_medkit
inv_name_short		= st_medkit
description			= st_medkit_descr
inv_weight			= 0.426

inv_grid_width		= 1
inv_grid_height		= 1
inv_grid_x			= 1
inv_grid_y			= 1
cost				= 950

boost_time				= 0.0
boost_health_restore	= 0.0
boost_radiation_restore	= 0.0
boost_bleeding_restore	= 0.00

use_sound			= $silent

hud = medkit_hud_model
trash_object = medkit_trash

change_outfit_svoboda_exo_outfit = medkit_exo
change_outfit_exo_outfit = medkit_exo



[medkit_exo]
hud = medkit_exo_hud_model


[medkit_script]:booster ;Do not use! Used in xr_wounded
script_binding = medkit_script_binder.init
;$spawn 				= "food and drugs\medkit_script"
visual				= dynamics\devices\dev_aptechka\dev_aptechka_low.ogf
inv_name			= _medkit
inv_name_short		= _medkit
description			= _medkit_descr
inv_weight			= 0.1

inv_grid_width		= 1
inv_grid_height		= 1
inv_grid_x			= 6
inv_grid_y			= 14
cost				= 300

;eatable item
eat_health			= 0.5
eat_max_power		= 0.1
eat_radiation		= -0.05
wounds_heal_perc	= 0.1
eat_portions_num	= 1

use_sound			= interface\inv_medkit

eat_sleepiness				= 0.0

eat_alcohol				= 0.0
eat_satiety 			= 0.0

;AI Tweaks xr_help_wounded
attach_angle_offset		= -2.6,2.3,0
attach_position_offset	= 0.156, -0.035081, 0.05
attach_bone_name    = bip01_l_hand
auto_attach       = false

[medkit_trash]:gwr_base_trash
visual                        = gwr\equipment\medkit\medkit_trash.ogf

;направление, в котором предмет отбрасывается
throw_dir = right
;смещение точки спавна относительно камеры
throw_offset_y = -0.6	//вверх-вниз
throw_offset_x = -0.2	//вперед-назад
throw_offset_z =  0.6	//положительные - в сторону броска, отрицательное - в противоположную

throw_impulse_y = -90
throw_impulse_z = 180

