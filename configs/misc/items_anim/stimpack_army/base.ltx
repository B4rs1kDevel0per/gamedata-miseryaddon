#include "eatable_objects.ltx"
#include "hud_objects.ltx"


[stimpack_army]:booster
$spawn 				= "food and drugs\stimpack_army"
visual				= dynamics\devices\dev_antirad\dev_antirad.ogf
inv_name			= st_stim_military
inv_name_short			= st_stim_military
description			= st_stim_military_descr
inv_weight			= 0.094

inv_grid_width     = 1
inv_grid_height    = 1
inv_grid_x         = 1
inv_grid_y         = 46
cost				= 2250

use_sound			= $silent ;interface\inv_medkit

hud = stimpack_army_hud_model
trash_object = stimpack_army_trash

change_outfit_svoboda_exo_outfit = stimpack_army_exo
change_outfit_exo_outfit = stimpack_army_exo



[stimpack_army_exo]
hud = stimpack_army_exo_hud_model



[stimpack_army_trash]:gwr_base_trash
visual                        = dynamics\devices\dev_antirad\dev_antirad_trash.ogf

;направление, в котором предмет отбрасывается
throw_dir = right
;смещение точки спавна относительно камеры
throw_offset_y = -0.6	//вверх-вниз
throw_offset_x = -0.2	//вперед-назад
throw_offset_z = -0.6	//положительные - в сторону броска, отрицательное - в противоположную

throw_impulse_y = -90
throw_impulse_z = 180

