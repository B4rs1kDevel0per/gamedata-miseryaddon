#include "eatable_objects.ltx"
#include "hud_objects.ltx"


[akvatab]:booster ;x4

;***********************************************************
hud = akvatab_hud_model
helm_prohibited = false; true
full_outfit_prohibited = false ;true

base_object = akvatab ;показывает, какая секция является базовой для "одинаковых" предметов разной степени целостности
uses_count = 4	    ;Сколько раз предмет можно использовать

;При первом использовании всегда съедается базовый предмет
using_2 = akvatab2	;Секция предмета, который будет заспавнен после первого использования, и который отвечает за второе использование
using_3 = akvatab3	;Аналогично для второго использования
using_4 = akvatab4
;************************************************************

$spawn 				= "food and drugs\akvatab"
visual				= dynamics\equipments\medical\drug_antidot.ogf
inv_name			= st_akvatab
inv_name_short		= st_akvatab
description			= st_akvatab_descr

inv_grid_width		= 1
inv_grid_height		= 1
inv_grid_x			= 5
inv_grid_y			= 5
cost				= 6032
inv_weight			= 0.008

use_sound			= $silent

[akvatab2]:akvatab
inv_name			= st_akvatab2
inv_name_short		= st_akvatab2
inv_weight			= 0.006
hud = akvatab_hud_model2
cost				= 4524

inv_grid_x			= 5
inv_grid_y			= 6

[akvatab3]:akvatab
inv_name			= st_akvatab3
inv_name_short		= st_akvatab3
inv_weight			= 0.004
hud = akvatab_hud_model3
cost				= 3016

inv_grid_x			= 5
inv_grid_y			= 7

[akvatab4]:akvatab
inv_name			= st_akvatab4
inv_name_short		= st_akvatab4
hud = akvatab_hud_model4
inv_weight			= 0.002
trash_object = akvatab_trash
cost				= 1508

inv_grid_x			= 5
inv_grid_y			= 8

[akvatab_trash]:gwr_base_trash
visual                        = dynamics\equipments\medical\drug_antidot_trash.ogf

;направление, в котором предмет отбрасывается
throw_dir = right
;смещение точки спавна относительно камеры
throw_offset_y = -0.6	//вверх-вниз
throw_offset_x = -0.2	//вперед-назад
throw_offset_z =  0.6	//положительные - в сторону броска, отрицательное - в противоположную

throw_impulse_y = -90
throw_impulse_z = 180