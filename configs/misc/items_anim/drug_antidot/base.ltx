#include "eatable_objects.ltx"
#include "hud_objects.ltx"


[drug_antidot]:booster ;x3

;***********************************************************
hud = drug_antidot_hud_model
helm_prohibited = false; true
full_outfit_prohibited = false ;true

base_object = drug_antidot ;показывает, какая секция является базовой для "одинаковых" предметов разной степени целостности
uses_count = 3	    ;Сколько раз предмет можно использовать

;При первом использовании всегда съедается базовый предмет
using_2 = drug_antidot2	;Секция предмета, который будет заспавнен после первого использования, и который отвечает за второе использование
using_3 = drug_antidot3	;Аналогично для второго использования
;************************************************************

$spawn 				= "food and drugs\drug_antidot"
visual				= dynamics\equipments\medical\drug_antidot.ogf
inv_name			= st_drug_antidot
inv_name_short		= st_drug_antidot
description			= st_drug_antidot_descr

inv_grid_width		= 1
inv_grid_height		= 1
inv_grid_x			= 0
inv_grid_y			= 5
cost				= 3360
inv_weight			= 0.01

use_sound			= $silent

[drug_antidot2]:drug_antidot
inv_name			= st_drug_antidot2
inv_name_short		= st_drug_antidot2
inv_weight			= 0.007
hud = drug_antidot_hud_model2
cost				= 2240

inv_grid_x			= 0
inv_grid_y			= 6

[drug_antidot3]:drug_antidot
inv_name			= st_drug_antidot3
inv_name_short		= st_drug_antidot3
hud = drug_antidot_hud_model3
inv_weight			= 0.004
trash_object = drug_antidot_trash
cost				= 1120

inv_grid_x			= 0
inv_grid_y			= 7

[drug_antidot_trash]:gwr_base_trash
visual                        = dynamics\equipments\medical\drug_antidot_trash.ogf

;направление, в котором предмет отбрасывается
throw_dir = right
;смещение точки спавна относительно камеры
throw_offset_y = -0.6	//вверх-вниз
throw_offset_x = 0.2	//вперед-назад
throw_offset_z =  0.6	//положительные - в сторону броска, отрицательное - в противоположную

throw_impulse_y = -90
throw_impulse_z = 180