#include "hud_objects.ltx"
#include "eatable_objects.ltx"

[mineral_water]:booster
;***********************************************************
hud = mineral_water_hud_model
helm_prohibited = false; true
full_outfit_prohibited = false ;true

base_object = mineral_water ;показывает, какая секция является базовой для "одинаковых" предметов разной степени целостности
uses_count = 3	    ;Сколько раз предмет можно использовать

;При первом использовании всегда съедается базовый предмет
using_2 = mineral_water2	;Секция предмета, который будет заспавнен после первого использования, и который отвечает за второе использование
using_3 = mineral_water3	;Аналогично для второго использования
;************************************************************

$spawn 				= "food and drugs\mineral_water"
cform				= skeleton
visual				= gwr\food\water\water.ogf
description			= st_mineral_water_descr

inv_name			= st_mineral_water
inv_name_short		= st_mineral_water
inv_weight			= 1.035

inv_grid_width		= 1
inv_grid_height		= 2
inv_grid_x			= 20
inv_grid_y			= 46
cost				= 1719

attach_angle_offset		= 0.000000, 0.000000, 0.000000
attach_position_offset	= 0.087266, -0.078540, 0.052360
attach_bone_name		= bip01_r_hand
auto_attach				= false

bone_name				= bip01_r_hand
position_offset			 = 0.0,0.0,0.0
angle_offset			 = 1.570790,1.570790,3.92699

break_particles		= destroy_fx\destroy_bottle
break_sound			= material\bottle\collide\bottle_break_1

boost_time				= 0.0
boost_radiation_restore	= 0.00
eat_alcohol				= 0.0
eat_satiety				= 0.0

use_sound			= $silent ;interface\inv_vodka

repair_part_bonus		= 0.01

[mineral_water2]:mineral_water
inv_name			= st_mineral_water2
inv_name_short		= st_mineral_water2
hud = mineral_water_hud_model2
cost				= 1196
inv_weight			= 0.701
inv_grid_x			= 21
inv_grid_y			= 46

[mineral_water3]:mineral_water
