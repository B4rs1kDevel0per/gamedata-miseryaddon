#include "eatable_objects.ltx"
#include "hud_objects.ltx"


[caffeine]:booster ;x5

;***********************************************************
hud = caffeine_hud_model
helm_prohibited = false; true
full_outfit_prohibited = false ;true

base_object = caffeine ;показывает, какая секция является базовой для "одинаковых" предметов разной степени целостности
uses_count = 5	    ;Сколько раз предмет можно использовать

;При первом использовании всегда съедается базовый предмет
using_2 = caffeine2	;Секция предмета, который будет заспавнен после первого использования, и который отвечает за второе использование
using_3 = caffeine3	;Аналогично для второго использования
using_4 = caffeine4
using_5 = caffeine5
;************************************************************

$spawn 				= "food and drugs\caffeine"
visual				= dynamics\equipments\medical\drug_coagulant.ogf
inv_name			= st_caffeine
inv_name_short		= st_caffeine
description			= st_caffeine_descr

inv_grid_width		= 1
inv_grid_height		= 1
inv_grid_x			= 6
inv_grid_y			= 5
cost			= 2550
inv_weight			= 0.011

use_sound			= $silent

[caffeine2]:caffeine
inv_name			= st_caffeine2
inv_name_short		= st_caffeine2
inv_weight			= 0.009
hud = caffeine_hud_model2
cost				= 2040

inv_grid_x			= 6
inv_grid_y			= 6

[caffeine3]:caffeine
inv_name			= st_caffeine3
inv_name_short		= st_caffeine3
inv_weight			= 0.007
hud = caffeine_hud_model3
cost				= 1530

inv_grid_x			= 6
inv_grid_y			= 7

[caffeine4]:caffeine
inv_name			= st_caffeine4
inv_name_short		= st_caffeine4
inv_weight			= 0.005
hud = caffeine_hud_model4
cost				= 1020

inv_grid_x			= 6
inv_grid_y			= 8

[caffeine5]:caffeine
inv_name			= st_caffeine5
inv_name_short		= st_caffeine5
hud = caffeine_hud_model5
inv_weight			= 0.003
trash_object = caffeine_trash
cost				= 510

inv_grid_x			= 6
inv_grid_y			= 9

[caffeine_trash]:gwr_base_trash
visual                        = dynamics\equipments\medical\drug_coagulant_trash.ogf

;направление, в котором предмет отбрасывается
throw_dir = right
;смещение точки спавна относительно камеры
throw_offset_y = -0.6	//вверх-вниз
throw_offset_x = 0.2	//вперед-назад
throw_offset_z =  0.6	//положительные - в сторону броска, отрицательное - в противоположную

throw_impulse_y = -90
throw_impulse_z = 180