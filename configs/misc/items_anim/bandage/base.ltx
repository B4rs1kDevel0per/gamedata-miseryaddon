#include "eatable_objects.ltx"
#include "hud_objects.ltx"

[bandage]:booster
$spawn 				= "food and drugs\bandage"
visual				= dynamics\devices\dev_bandage\dev_bandage.ogf
description			= st_bandage_descr

ignore_eatable_boost = true
animation_slot 		= 2
inv_name			= st_bandage
inv_name_short		= st_bandage
inv_weight			= 0.038
cost				= 560

inv_grid_width		= 1
inv_grid_height		= 1
inv_grid_x			= 0
inv_grid_y			= 1

use_sound			= $silent

hud = bandage_hud_model
trash_object = bandage_trash


[bandage_trash]:gwr_base_trash
visual                        = dynamics\devices\dev_bandage\dev_bandage_trash.ogf

;направление, в котором предмет отбрасывается
throw_dir = right
;смещение точки спавна относительно камеры
throw_offset_y = -0.6	//вверх-вниз
throw_offset_x = -0.2	//вперед-назад
throw_offset_z = -0.6	//положительные - в сторону броска, отрицательное - в противоположную

throw_impulse_y = -90
throw_impulse_z = 180



