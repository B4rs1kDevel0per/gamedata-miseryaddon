[wpn_sig220r_worn]:wpn_sig220r
; --- Тексты и описания ---
inv_name                    = st_wpn_sig220r_worn
inv_name_short              = st_wpn_sig220r_worn
description                 = st_wpn_sig220r_worn_descr

; --- Экономика ---
cost                        = 11450                     ; Цена упала (у оригинала 19230), так как пушка б/у

; --- Боевые характеристики (ТТХ) ---
hit_power                   = 0.465, 0.465, 0.465, 0.465 ; Урон снижен из-за износа ствола (у оригинала 0.509)
bullet_speed                = 260                       ; Начальная скорость пули упала (у оригинала 292)

; --- Надежность и заклинивания (Хардкор Мизери) ---
misfire_start_condition     = 0.88                      ; Начнет клинить уже при износе в 12% (оригинал держался до 24% / 0.76)
misfire_start_prob          = 0.035                     ; Шанс поймать осечку на начальном этапе стал выше (было 0.007)
misfire_end_prob            = 0.24                      ; В "убитом" состоянии будет клинить постоянно (было 0.085)

condition_shot_dec          = 0.0024                    ; Ломается в 2.4 раза быстрее оригинала (было 0.0010)
condition_queue_shot_dec    = 0.0024                    ; Износ при быстром кликанье

; --- Сетка инвентаря ---
inv_grid_x                  = 16                        ; Координаты иконки наследуются, но продублированы. 
inv_grid_y                  = 28                        ; Если сделаешь текстуру ржавого Сига — впиши сюда новые координаты.

hud                     	= wpn_sig220r_worn_hud


