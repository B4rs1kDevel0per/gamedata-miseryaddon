[sr_idle@pas_b400_sr_canalisation_6]
on_info = {=any_actor_in_zone(pas_b400_sr_canalisation_5) !any_actor_in_zone(pas_b400_sr_canalisation_6)} sr_idle@pas_b400_sr_canalisation_5 %-PAS_B400_SR_CANALISATION_6 +PAS_B400_SR_CANALISATION_5%
