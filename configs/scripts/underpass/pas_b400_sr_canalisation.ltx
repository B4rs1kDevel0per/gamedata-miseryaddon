on_info3 = {-PAS_B400_CANALISATION_ZOMBIED_3_ATTACKED} %+PAS_B400_CANALISATION_ZOMBIED_3_ATTACKED =heal_squad(pas_b400_stalkers_squad)%

[sr_idle@pas_b400_sr_canalisation_4]
on_info = {=any_actor_in_zone(pas_b400_sr_canalisation_3) !any_actor_in_zone(pas_b400_sr_canalisation_4)} sr_idle@pas_b400_sr_canalisation_3 %-PAS_B400_SR_CANALISATION_4 +PAS_B400_SR_CANALISATION_3%
