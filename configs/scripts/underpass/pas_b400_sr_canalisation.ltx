on_info4 = {-PAS_B400_CANALISATION_ZOMBIED_3_ATTACKED =any_actor_in_zone(pas_b400_sr_canalisation_3)} %+PAS_B400_CANALISATION_ZOMBIED_3_ATTACKED =heal_squad(pas_b400_stalkers_squad)%
