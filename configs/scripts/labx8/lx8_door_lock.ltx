[logic]
active = ph_button@no_card

[ph_button@no_card]
anim = idle
tooltip = tip_no_access_card
on_info = {=isServer =any_actor_has_item(zat_a23_labx8_key)} ph_button@has_card, {=isClient =actor_has_item(zat_a23_labx8_key)} ph_button@has_card
on_info2 = {+LX8_DOOR_BUTTON_PRESS} ph_button@unlocked

[ph_button@has_card]
anim = idle
tooltip = tip_need_access_card
local_use = true
on_press = ph_button@unlocked %+LX8_DOOR_BUTTON_PRESS%
on_info = {=isServer !any_actor_has_item(zat_a23_labx8_key)} ph_button@no_card, {=isClient !actor_has_item(zat_a23_labx8_key)} ph_button@no_card
on_info2 = {+LX8_DOOR_BUTTON_PRESS} ph_button@unlocked

[ph_button@unlocked]
anim = idle
tooltip = st_lx8_button_press_true
on_game_timer = 20 | {=isServer -LX8_DOOR_OPEN} %+LX8_DOOR_OPEN%  
on_game_timer2 = 10 | {=isServer -LX8_GREEN_ON} %+LX8_GREEN_ON =turn_off(lx8_light_switch_1_red_id) =turn_on(lx8_light_switch_1_green_id)%
on_info = {=isServer =any_actor_in_zone(lx8_sr_actor_in_lab) -LX8_ACTOR_IN_LAB} %+LX8_ACTOR_IN_LAB =create_squad(lx8_polter_squad:lx8_smart_terrain)%
on_info2 = {=isServer +LX8_DOOR_OPEN -LX8_DOOR_OPENED} %+LX8_DOOR_OPENED =anim_obj_forward(lx8_physic_door)%  