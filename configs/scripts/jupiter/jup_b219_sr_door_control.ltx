[logic]
active = sr_idle
type = sv_only

[sr_idle]
on_info = {+JUP_B219_OPENING} sr_idle@close %=anim_obj_forward(jup_b219_lift_big_1) =jup_b219_save_pos%

[sr_idle@close] 
on_info = {+JUP_B219_DESTROY_ACTOR} sr_idle@nil %=anim_obj_backward(jup_b219_lift_big_1) =jup_b219_restore_gate%

[sr_idle@nil]
