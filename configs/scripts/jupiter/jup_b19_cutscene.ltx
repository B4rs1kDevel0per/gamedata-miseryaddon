[logic]
active = sr_idle@determine_cl_sv
type = shared_with_cl_data

[sr_idle@determine_cl_sv]
on_info = {=isServer} sr_idle@sv_wait
on_info2 = {=isClient} sr_idle@cl_wait

;server logic
[sr_idle@sv_wait]
on_info = {+JUP_B19_MERC_SPAWNED} sr_idle@nil
on_info2 = {+JUP_B19_FAIL} sr_idle@nil

;client logic
[sr_idle@cl_wait]
on_info = {+JUP_B19_MERC_SPAWNED =is_local_actor_relevant(25:jup_b19_freedom_yar)} sr_cutscene@cl_cam1  %=disable_ui%, {+JUP_B19_MERC_SPAWNED !is_local_actor_relevant(25:jup_b19_freedom_yar)} sr_idle@nil
on_info2 = {+JUP_B19_FAIL} sr_idle@nil

[sr_cutscene@cl_cam1]
point = jup_b19_merc4_10_walk
look = jup_b19_merc1_4_look
cam_effector = scenario_cam\Jupiter\jup_b19_waiting_for_mercs
on_signal = cameff_end | sr_idle@nil
global_cameffect = true
enable_ui_on_end = true  
outdoor = true
on_info = {+JUP_B19_FIGHT_BEGUN} %=stop_sr_cutscene%

[sr_idle@nil]