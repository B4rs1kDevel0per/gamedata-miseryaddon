[logic]
active = sr_idle@wait
type = sv_only

[sr_idle@wait]
on_info = {=any_actor_in_zone(jup_b213_close_to_toolkit) =any_actor_has_item(toolkit_1)} sr_idle@with_toolkit
on_info2 = {=any_actor_in_zone(jup_b213_close_to_toolkit) !any_actor_has_item(toolkit_1)} sr_idle@get_toolkit

[sr_idle@get_toolkit]
on_info = {!any_actor_in_zone(jup_b213_close_to_toolkit)} sr_idle@wait
on_info2 = {=any_actor_has_item(toolkit_1)} sr_idle@got_toolkit

[sr_idle@got_toolkit]
on_info = {!any_actor_in_zone(jup_b213_close_to_toolkit)} sr_idle@nil %+JUP_B213_TOOLKIT_1_ON_BOARD%

[sr_idle@with_toolkit]
on_info = {!any_actor_in_zone(jup_b213_close_to_toolkit)} sr_idle@wait
on_info2 = {=actor_has_item_count(toolkit_1:2)} sr_idle@got_toolkit

[sr_idle@nil]