[logic]
active = sr_idle@determine_cl_sv
type = shared_with_cl_data

[sr_idle@determine_cl_sv]
on_info = {=isServer} sr_idle@sv_begin
on_info2 = {=isClient} sr_idle@cl_wait

;server logic
[sr_idle@sv_begin]
on_info = {+JUP_B4_MONOLITH_SQUAD_HELP -TASK_JUP_B4_MONOLITH_SQUAD_HELP -JUP_B4_MONOLITH_SQUAD_OUT} sr_idle@sv_wait %=give_task(jup_b4_monolith_squad_help) +TASK_JUP_B4_MONOLITH_SQUAD_HELP%

[sr_idle@sv_wait]
on_info = {+JUP_B4_DUTY_GO_TO_MONOLIT_SQUAD} sr_idle@sv_dolg_teleport %+JUP_B4_MONOLITH_CUT_CL%
on_info2 = {+JUP_B4_FREEDOM_GO_TO_MONOLIT_SQUAD} sr_idle@sv_freedom_teleport %+JUP_B4_MONOLITH_CUT_CL%
on_info3 = {+JUP_B4_MONOLITH_SQUAD_OUT} sr_idle@nil

[sr_idle@sv_dolg_teleport]
on_timer = 1000 | {-JUP_B4_TELEPORT_TO_MONOLIT} sr_idle@sv_dolg %=forward_game_time(2) =create_squad(jup_b4_duty_squad:jup_b4) +JUP_B4_TELEPORT_TO_MONOLIT%
on_info = {+JUP_B4_MONOLITH_SQUAD_OUT} sr_idle@nil

[sr_idle@sv_dolg]
on_info = %+JUP_B4_DUTY_START_SPEECH%
on_info2 = {+JUP_B4_DUTY_SQUAD_LEADER_FINAL_SOUND_END} sr_idle@sv_duty_skin %+JUP_B4_MONOLITH_CUT_SKIN% 
on_info3 = {+JUP_B4_MONOLITH_SQUAD_OUT} sr_idle@sv_fade
on_info4 = {+JUP_B4_ACTOR_GO_AWAY} sr_idle@nil

[sr_idle@sv_duty_skin]
on_timer = 1000 | sr_idle@sv_duty_go_home %+JUP_B4_MONOLITH_SQUAD_IN_DUTY =remove_squad(jup_b4_squad) =create_squad(jup_b4_squad_duty:jup_b4) =create_squad(jup_b4_squad_duty_leader:jup_b4) +JUP_B4_MONOLITH_CUT_SKIN_UI%
on_info = {+JUP_B4_MONOLITH_SQUAD_OUT} sr_idle@nil

[sr_idle@sv_duty_go_home]
on_timer = 60000 | {-JUP_B4_DUTY_GO_HOME -JUP_B4_DUTY_GO_HOME_ALONE} sr_idle@nil %+JUP_B4_DUTY_GO_HOME_ALONE%
on_info = {+JUP_B4_DUTY_GO_HOME} sr_idle@sv_fade

[sr_idle@sv_freedom_teleport]
on_timer = 1000 | {-JUP_B4_TELEPORT_TO_MONOLIT} sr_idle@sv_freedom %=forward_game_time(2) =create_squad(jup_b4_freedom_squad:jup_b4) +JUP_B4_TELEPORT_TO_MONOLIT%
on_info = {+JUP_B4_MONOLITH_SQUAD_OUT} sr_idle@nil

[sr_idle@sv_freedom]
on_info = {+JUP_B4_RECRUIT_2_COOL_FREEDOM_SOUND} sr_idle@sv_freedom_skin %+JUP_B4_MONOLITH_CUT_SKIN%
on_info2 = {+JUP_B4_MONOLITH_SQUAD_OUT} sr_idle@nil
on_info3 = {+JUP_B4_ACTOR_GO_AWAY} sr_idle@nil

[sr_idle@sv_freedom_skin]
on_timer = 1000 | sr_idle@sv_freedom_go_home %+JUP_B4_MONOLITH_SQUAD_IN_FREEDOM =remove_squad(jup_b4_squad) =create_squad(jup_b4_squad_freedom:jup_b4) =create_squad(jup_b4_squad_freedom_leader:jup_b4) +JUP_B4_MONOLITH_CUT_SKIN_UI%

[sr_idle@sv_freedom_go_home]
on_timer = 60000 | {-JUP_B4_FREEDOM_GO_HOME -JUP_B4_FREEDOM_GO_HOME_ALONE} sr_idle@nil %+JUP_B4_FREEDOM_GO_HOME_ALONE%
on_info = {+JUP_B4_FREEDOM_GO_HOME} sr_idle@sv_fade

[sr_idle@sv_fade]
on_info = {-JUP_B4_FADE +JUP_B4_DUTY_GO_HOME} sr_idle@sv_teleport_duty %=run_postprocess(fade_in_out) =disable_ui +JUP_B4_FADE%
on_info2 = {-JUP_B4_FADE +JUP_B4_FREEDOM_GO_HOME} sr_idle@sv_teleport_freedom %=run_postprocess(fade_in_out) =disable_ui +JUP_B4_FADE%

[sr_idle@sv_teleport_duty]
on_game_timer = 30 | {-JUP_B4_MONOLITH_SQUAD_ON_BASE} sr_idle@on_base_a6 %+JUP_B4_MONOLITH_SQUAD_ON_BASE =forward_game_time(2) =teleport_squad(jup_b4_squad_duty : jup_a6_actor_look) =teleport_squad(jup_b4_squad_duty_leader : jup_a6_actor_look) =teleport_squad(jup_b4_duty_squad : jup_a6_actor_look)%

[sr_idle@sv_teleport_freedom]
on_game_timer = 30 | {-JUP_B4_MONOLITH_SQUAD_ON_BASE} sr_idle@on_base_a6 %+JUP_B4_MONOLITH_SQUAD_ON_BASE =forward_game_time(2) =teleport_squad(jup_b4_squad_freedom:jup_a6_actor_look) =teleport_squad(jup_b4_squad_freedom_leader:jup_a6_actor_look) =teleport_squad(jup_b4_freedom_squad:jup_a6_actor_look)%

[sr_idle@on_base_a6]
on_game_timer = 30 | sr_idle@nil %+JUP_B4_FADE_UI%

;client logic
[sr_idle@cl_wait]
on_info = {+JUP_B4_MONOLITH_CUT_CL +JUP_B4_DUTY_GO_TO_MONOLIT_SQUAD =is_local_actor_relevant(10:jup_a6_duty_leader)} sr_idle@cl_teleport %=run_postprocess(fade_in_out) =disable_ui%, {+JUP_B4_MONOLITH_CUT_CL +JUP_B4_FREEDOM_GO_TO_MONOLIT_SQUAD =is_local_actor_relevant(10:jup_a6_freedom_leader)} sr_idle@cl_teleport %=run_postprocess(fade_in_out) =disable_ui%, {+JUP_B4_MONOLITH_CUT_CL +JUP_B4_DUTY_GO_TO_MONOLIT_SQUAD !is_local_actor_relevant(10:jup_a6_duty_leader)} sr_idle@cl_go_home, {+JUP_B4_MONOLITH_CUT_CL +JUP_B4_FREEDOM_GO_TO_MONOLIT_SQUAD !is_local_actor_relevant(10:jup_a6_freedom_leader)} sr_idle@cl_go_home

[sr_idle@cl_teleport]
on_info = {+JUP_B4_TELEPORT_TO_MONOLIT} sr_idle@cl_wait2 %=xrmpe_teleport_local_actor(jup_b4_teleport_actor_walk:jup_b4_teleport_actor_look) =enable_ui%
on_info2 = {+JUP_B4_MONOLITH_SQUAD_OUT} sr_idle@nil

[sr_idle@cl_wait2]
on_info = {+JUP_B4_MONOLITH_CUT_SKIN} sr_idle@cl_wait3 %=run_postprocess(fade_in_out) =disable_ui% 

[sr_idle@cl_wait3]
on_info = {+JUP_B4_MONOLITH_CUT_SKIN_UI} sr_idle@cl_go_home %=enable_ui%

[sr_idle@cl_go_home]
on_info = {+JUP_B4_DUTY_GO_HOME_ALONE} sr_idle@nil
on_info2 = {+JUP_B4_DUTY_GO_HOME =is_local_relevant(20:jup_b4_monolith_squad_leader_freedom_skin)} sr_idle@cl_fade, {+JUP_B4_DUTY_GO_HOME =is_local_relevant(20:jup_b4_monolith_squad_leader_duty_skin)} sr_idle@cl_fade, {+JUP_B4_DUTY_GO_HOME !is_local_relevant(20:jup_b4_monolith_squad_leader_freedom_skin)} sr_idle@nil, {+JUP_B4_DUTY_GO_HOME !is_local_relevant(20:jup_b4_monolith_squad_leader_duty_skin)} sr_idle@nil

[sr_idle@cl_fade]
on_info = {+JUP_B4_FADE +JUP_B4_DUTY_GO_HOME} sr_idle@cl_teleport_home %=run_postprocess(fade_in_out) =disable_ui%

[sr_idle@cl_teleport_home]
on_info = {+JUP_B4_MONOLITH_SQUAD_ON_BASE} sr_idle@cl_on_base_a6 %=xrmpe_teleport_local_actor(jup_actor_arrive_walk : jup_actor_arrive_look)%

[sr_idle@cl_on_base_a6]
on_info = {+JUP_B4_FADE_UI} sr_idle@nil %=enable_ui%

[sr_idle@nil]
