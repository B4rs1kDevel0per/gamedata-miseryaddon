[sr_idle@count_2]
on_info =  {=counter_equal(jup_b6_anom_2_st_count:4) -JUP_B6_ANOM_2_COUNT_1_END} %=inc_counter(jup_b6_anom_2_count_1:8)%, {=counter_equal(jup_b6_anom_2_st_count:3) -JUP_B6_ANOM_2_COUNT_1_END} %=inc_counter(jup_b6_anom_2_count_1:6)%, {=counter_equal(jup_b6_anom_2_st_count:2) -JUP_B6_ANOM_2_COUNT_1_END} %=inc_counter(jup_b6_anom_2_count_1:4)%, {=counter_equal(jup_b6_anom_2_st_count:1) -JUP_B6_ANOM_2_COUNT_1_END} %=inc_counter(jup_b6_anom_2_count_1:2)%
