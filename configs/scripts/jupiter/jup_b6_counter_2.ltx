on_info4 = {=counter_equal(jup_b6_anom_2_st_count:4) -JUP_B6_ANOM_2_COUNT_4_END +JUP_B6_ANOM_2_COUNT_3_END} %=inc_counter(jup_b6_anom_2_count_4:8)%, {=counter_equal(jup_b6_anom_2_st_count:3) -JUP_B6_ANOM_2_COUNT_4_END +JUP_B6_ANOM_2_COUNT_3_END} %=inc_counter(jup_b6_anom_2_count_4:6)%, {=counter_equal(jup_b6_anom_2_st_count:2) -JUP_B6_ANOM_2_COUNT_4_END +JUP_B6_ANOM_2_COUNT_3_END} %=inc_counter(jup_b6_anom_2_count_4:4)%, {=counter_equal(jup_b6_anom_2_st_count:1) -JUP_B6_ANOM_2_COUNT_4_END +JUP_B6_ANOM_2_COUNT_3_END} %=inc_counter(jup_b6_anom_2_count_4:2)%
on_info5 = {+JUP_B6_TASK_FAIL} sr_idle@end, {+JUP_B6_ANOM_2_COUNT_END} sr_idle, sr_idle@count_idle_2

[sr_idle@count_idle_1]
on_game_timer = 20 | sr_idle@count_1

[sr_idle@count_idle_2]
on_game_timer = 20 | sr_idle@count_2

[sr_idle@end]


