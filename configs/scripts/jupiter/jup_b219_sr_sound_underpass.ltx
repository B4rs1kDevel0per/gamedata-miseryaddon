[logic]
active = sr_idle@determine_cl_sv
type = shared_with_cl_data

[sr_idle@determine_cl_sv]
on_info = {=isServer} sr_idle@sv_wait
on_info2 = {=isClient} sr_idle@cl_wait

;server logic
[sr_idle@sv_wait]
on_info = {+JUP_B219_OPENING} sr_idle@sv_wait2 

[sr_idle@sv_wait2]
on_timer = 1000 | sr_idle@nil %+JUP_B219_OPENING_SND%

;client logic     
[sr_idle@cl_wait]
on_info = {+JUP_B219_OPENING_SND} sr_idle@nil %=play_sound(jup_b219_underpass_opening)%

[sr_idle@nil]