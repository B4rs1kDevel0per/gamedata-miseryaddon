[smart_terrain]
squad_id = 9
max_population = 2
respawn_params = respawn@jup_b200   

[respawn@jup_b200]
spawn_freedom@advanced
spawn_freedom@veteran
spawn_freedom@sci

[spawn_freedom@advanced]
spawn_squads = freedom_sim_squad_advanced
spawn_num = 2

[spawn_freedom@veteran]
spawn_squads = freedom_sim_squad_veteran
spawn_num = {+JUP_B1_TASK_DONE +JUP_B1_CONTROLLER_IS_DEAD} 2, 1

[spawn_freedom@sci]
spawn_squads = freedom_sci_simulation_squad
spawn_num = 1

