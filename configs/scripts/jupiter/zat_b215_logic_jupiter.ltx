[logic]
active = sr_idle@determine_cl_sv
type = no_save

[sr_idle@determine_cl_sv]
on_info = {=isServer} sr_idle@sv_control
on_info2 = {=isClient} sr_idle@cl_control

;server logic
[sr_idle@sv_control]
on_info1 = {+JUP_FIRST_MEET_MADE -JUP_TRAVEL_MADE -ZAT_B215_GUIDE_TO_ZATON} sr_idle@sv_on_jup_aborigen %=xrmpe_teleport_actors(jup_actor_arrive_walk:jup_actor_arrive_look) +JUP_TRAVEL_MADE -ZAT_B215_GUIDE_TO_ZATON%, {-JUP_FIRST_MEET_MADE -JUP_TRAVEL_MADE} sr_idle@sv_on_jup_guest %=xrmpe_teleport_actors(jup_a6_actor_walk:jup_a6_actor_look) +JUP_TRAVEL_MADE -ZAT_B215_GUIDE_TO_ZATON%
on_info2 = {+ZAT_B215_GUIDE_TO_ZATON +JUP_TRAVEL_MADE} sr_idle@sv_to_zat_meet

[sr_idle@sv_on_jup_guest]
on_game_timer = 100 | {-JUP_B217_TASK_START} sr_idle@sv_control %+JUP_B217_TASK_START +JUP_FIRST_MEET_MADE +JUP_B217_WELCOME_FADED%

[sr_idle@sv_on_jup_aborigen]
on_game_timer = 25 | sr_idle@sv_control

[sr_idle@sv_to_zat_meet]
on_info = {-ZAT_B215_TO_ZAT_PP_START} %+ZAT_B215_TO_ZAT_PP_START -JUP_TRAVEL_MADE%
on_game_timer = 25 | sr_idle@sv_control %=xrmpe_teleport_actors(jup_goto_zaton_walk:jup_goto_zaton_look) =forward_game_time(4) -ZAT_B215_TO_ZAT_PP_START%

;client logic
[sr_idle@cl_control]
on_info1 = {+JUP_FIRST_MEET_MADE -JUP_TRAVEL_MADE -ZAT_B215_GUIDE_TO_ZATON} sr_idle@cl_on_jup_aborigen %=run_postprocess(black:1238:true) =disable_ui%, {-JUP_FIRST_MEET_MADE -JUP_TRAVEL_MADE} sr_idle@cl_control %=disable_ui =run_postprocess(black:1239:true)%
on_info2 = {+ZAT_B215_GUIDE_TO_ZATON +JUP_TRAVEL_MADE} sr_idle@cl_to_zat_meet %=run_postprocess(fade_in) =disable_ui%
on_info3 = {+UNI_LEAVE_ZONE_INFO} sr_idle@cl_leave_zone %=disable_ui =run_postprocess(fade_in)% 

[sr_idle@cl_on_jup_aborigen]
on_game_timer = 25 | sr_idle@cl_control %=enable_ui =stop_postprocess(1238)%

[sr_idle@cl_to_zat_meet]
on_info = {+ZAT_B215_TO_ZAT_PP_START} %=run_postprocess(black:1240:true)%
on_game_timer = 25 | sr_idle@cl_control

[sr_idle@cl_leave_zone]
on_game_timer = 20 | nil %=run_tutorial(outro_game)%



