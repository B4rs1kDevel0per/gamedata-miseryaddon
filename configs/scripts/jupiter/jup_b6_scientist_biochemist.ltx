combat_ignore_cond = {=check_enemy_smart(jup_b41)} true
on_info  = {-JUP_B1_SCI_TASK_CONTROLLER_START} %+JUP_B1_SCI_TASK_CONTROLLER_START =set_counter(jup_b1_sci_task_controller_count:0)% 
