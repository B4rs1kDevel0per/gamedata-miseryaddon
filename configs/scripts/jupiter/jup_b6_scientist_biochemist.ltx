[logic@jup_b6_scientist_biochemist]
suitable = {=check_npc_name(jup_b6_scientist_biochemist)} true
prior = 200
active = walker@firstmeet

[walker@firstmeet]
path_walk = bio_walk
path_look  = bio_look
