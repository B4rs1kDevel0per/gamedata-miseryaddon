[logic]
active = sr_idle@determine_cl_sv
type = shared_with_cl_data

[sr_idle@determine_cl_sv]
on_info = {=isServer} sr_idle@sv_teleport_to
on_info2 = {=isClient} sr_idle@cl_teleport_to

;server logic
[sr_idle@sv_teleport_to] ;переход к туннелю чеоез проводника
on_info = {+JUP_B1_TELEPORT_TO_TUNNEL} sr_idle@sv_teleportin, {+JUP_B1_GO_ON_TASK +JUP_B1_START} sr_idle@sv_teleport_wait_to_zombie
on_info2 = {+JUP_B1_TELEPORT_SQUAD_ONLY} sr_idle@sv_teleportin_squad %+JUP_B1_ST_MISSION%
on_info3 = {+JUP_B1_GO_ON_TASK =any_actor_in_zone(jup_b1_tuskano_spawn_zone)} sr_idle@sv_teleport_wait_to_zombie %+JUP_B1_START +JUP_B1_ST_MISSION%

[sr_idle@sv_teleportin]
on_game_timer = 20 | %+JUP_B1_TELEPORT_STEP_1 =xrmpe_teleport_relevant_actors(jup_b1_stalker_squad:jup_b1_actor_telep_stay_1:jup_b1_actor_telep_look_1:20) =teleport_squad(jup_b1_stalker_squad:jup_b1_stalker_spawn)%
on_info  = {+JUP_B1_TELEPORT_STEP_1} sr_idle@sv_teleport_post
on_info2 = {-JUP_B1_ZOMBIED_1_TELEPORTED} %=teleport_npc_by_story_id(jup_b1_zombie_1:jup_b1_zombie_spawn)  +JUP_B1_ZOMBIED_1_TELEPORTED%
on_info3 = {-JUP_B1_ZOMBIED_2_TELEPORTED} %=teleport_npc_by_story_id(jup_b1_zombie_2:jup_b1_zombie_stay_1) +JUP_B1_ZOMBIED_2_TELEPORTED%
on_info4 = {-JUP_B1_ZOMBIED_3_TELEPORTED} %=teleport_npc_by_story_id(jup_b1_zombie_3:jup_b1_zombie_stay_2) +JUP_B1_ZOMBIED_3_TELEPORTED%

[sr_idle@sv_teleportin_squad]
on_info = sr_idle@sv_teleport_wait_to_zombie %=teleport_squad(jup_b1_stalker_squad:jup_b1_stalker_spawn)%

[sr_idle@sv_teleport_post]
on_game_timer = 20 | %+JUP_B1_UI +JUP_B1_UI_CL%
on_info = {+JUP_B1_UI} sr_idle@sv_teleport_wait_to_zombie %-JUP_B1_UI +JUP_B1_ST_MISSION%

[sr_idle@sv_teleport_wait_to_zombie] ;зомбирование отряда контроллером
on_info = {=any_actor_has_item(jup_b1_half_artifact) =squad_exist(jup_b1_stalker_squad)} sr_idle@sv_zombie %+JUP_B1_ACTOR_HAS_HALF_ARTIFACT =teleport_squad(jup_b1_stalker_squad:jup_b1_surge_5_walk)%
on_info2 = {!squad_exist(jup_b1_stalker_squad)} sr_idle@nil

[sr_idle@sv_zombie]
on_game_timer = 1 | sr_idle@sv_teleport_wait_to_go_home   
on_info =  {-JUP_B1_STALKER_1_IS_DEAD -JUP_B1_ST_1_TELEPORTED_TO_ZOMBIED} %=teleport_npc_by_story_id(jup_b1_stalker_1:jup_b1_st_1_zombie_stay) +JUP_B1_ST_1_TELEPORTED_TO_ZOMBIED%
on_info2 = {-JUP_B1_STALKER_2_IS_DEAD -JUP_B1_ST_2_TELEPORTED_TO_ZOMBIED} %=teleport_npc_by_story_id(jup_b1_stalker_2:jup_b1_st_2_zombie_stay) +JUP_B1_ST_2_TELEPORTED_TO_ZOMBIED%
on_info3 = {-JUP_B1_STALKER_3_IS_DEAD -JUP_B1_ST_3_TELEPORTED_TO_ZOMBIED} %=teleport_npc_by_story_id(jup_b1_stalker_3:jup_b1_st_3_zombie_stay) +JUP_B1_ST_3_TELEPORTED_TO_ZOMBIED%
on_info4 = {-JUP_B1_STALKER_4_IS_DEAD -JUP_B1_ST_4_TELEPORTED_TO_ZOMBIED} %=teleport_npc_by_story_id(jup_b1_stalker_4:jup_b1_st_4_zombie_stay) +JUP_B1_ST_4_TELEPORTED_TO_ZOMBIED%

[sr_idle@sv_teleport_wait_to_go_home] ;возвращение с отрядом домой через проводника
on_info  = {+JUP_B1_TELEPORT_TO_HOME} sr_idle@sv_teleportin_2 %-JUP_B1_ST_MISSION -JUP_B1_GO_ON_TASK%
on_info2 = {+JUP_B1_GO_FROM_TASK +JUP_B1_TASK_DONE +JUP_B1_ST_MISSION} sr_idle@nil %=teleport_squad(jup_b1_stalker_squad:jup_b41_stalker_spawn) -JUP_B1_ST_MISSION%

[sr_idle@sv_teleportin_2]
on_game_timer = 20 | %+JUP_B1_TELEPORT_STEP_2 =xrmpe_teleport_relevant_actors(jup_b1_stalker_squad:jup_b1_actor_telep_stay_2:jup_b1_actor_telep_look_2:20) =teleport_squad(jup_b1_stalker_squad:jup_b41_stalker_spawn)%
on_info = {+JUP_B1_TELEPORT_STEP_2} sr_idle@sv_teleport_post_2

[sr_idle@sv_teleport_post_2]
on_game_timer = 20 | %+JUP_B1_UI +JUP_B1_UI_CL2%
on_info = {+JUP_B1_UI} sr_idle@nil %-JUP_B1_UI%
on_info2 = {-JUP_B1_STALKER_1_IS_DEAD -JUP_B1_ST_1_TELEPORTED_TO_BASE} %=teleport_npc_by_story_id(jup_b1_stalker_1:jup_b41_base_stay_st_1) +JUP_B1_ST_1_TELEPORTED_TO_BASE%
on_info3 = {-JUP_B1_STALKER_2_IS_DEAD -JUP_B1_ST_2_TELEPORTED_TO_BASE} %=teleport_npc_by_story_id(jup_b1_stalker_2:jup_b41_base_stay_st_2) +JUP_B1_ST_2_TELEPORTED_TO_BASE%
on_info4 = {-JUP_B1_STALKER_3_IS_DEAD -JUP_B1_ST_3_TELEPORTED_TO_BASE} %=teleport_npc_by_story_id(jup_b1_stalker_3:jup_b41_base_stay_st_3) +JUP_B1_ST_3_TELEPORTED_TO_BASE%
on_info5 = {-JUP_B1_STALKER_4_IS_DEAD -JUP_B1_ST_4_TELEPORTED_TO_BASE} %=teleport_npc_by_story_id(jup_b1_stalker_4:jup_b41_base_stay_st_4) +JUP_B1_ST_4_TELEPORTED_TO_BASE%

;client logic
[sr_idle@cl_teleport_to] ;переход к туннелю чеоез проводника
on_info = {+JUP_B1_TELEPORT_TO_TUNNEL =is_local_actor_relevant_squad(20:jup_b1_stalker_squad)} sr_idle@cl_teleportin %=run_postprocess(fade_in:8610) =disable_ui%, {+JUP_B1_TELEPORT_TO_TUNNEL !is_local_actor_relevant_squad(20:jup_b1_stalker_squad)} sr_idle@cl_teleport_wait_to_go_home, {+JUP_B1_GO_ON_TASK +JUP_B1_START} sr_idle@cl_teleport_wait_to_go_home

[sr_idle@cl_teleportin]
on_info  = {+JUP_B1_TELEPORT_STEP_1} sr_idle@cl_teleport_post %=run_postprocess(black:8611:true)%

[sr_idle@cl_teleport_post]
on_info = {+JUP_B1_UI_CL} sr_idle@cl_teleport_wait_to_go_home %=stop_postprocess(8610) =stop_postprocess(8611) =enable_ui%

[sr_idle@cl_teleport_wait_to_go_home] ;возвращение с отрядом домой через проводника
on_info  = {+JUP_B1_TELEPORT_TO_HOME =is_local_actor_relevant_squad(20:jup_b1_stalker_squad)} sr_idle@cl_teleportin_2 %=run_postprocess(fade_in:8613) =disable_ui%, {+JUP_B1_TELEPORT_TO_HOME !is_local_actor_relevant_squad(20:jup_b1_stalker_squad)} sr_idle@nil
on_info2 = {+JUP_B1_GO_FROM_TASK +JUP_B1_TASK_DONE +JUP_B1_ST_MISSION} sr_idle@nil

[sr_idle@cl_teleportin_2]
on_info = {+JUP_B1_TELEPORT_STEP_2} sr_idle@cl_teleport_post_2 %=run_postprocess(black:8614:true)%

[sr_idle@cl_teleport_post_2]
on_info = {+JUP_B1_UI_CL2} sr_idle@nil %=stop_postprocess(8613) =stop_postprocess(8614) =enable_ui%

[sr_idle@nil]