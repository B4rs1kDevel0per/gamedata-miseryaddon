[logic]
active = sr_idle@determine_cl_sv
type = shared_with_cl_data

[sr_idle@determine_cl_sv]
on_info = {=isServer} sr_idle@sv_jup_b46_sos_sound
on_info2 = {=isClient} sr_idle@cl_jup_b46_sos_sound

;server logic
[sr_idle@sv_jup_b46_sos_sound]
on_info  = {+JUP_B46_SPATIAL_BUBBLE_STARTED -JUP_B46_TASK_GIVED -JUP_B46_SPATIAL_BUBBLE_RUPTURED} %+JUP_B46_TASK_GIVED =give_task(jup_b46_spatial_bubble)% 
on_info2 = {+JUP_B46_SPATIAL_BUBBLE_RUPTURED} sr_idle@sv_jup_b46_rupture

[sr_idle@sv_jup_b46_rupture] 
on_game_timer = 46 | {-JUP_B46_DUTY_FOUNDER_SQUAD_SPAWNED} %+JUP_B46_DUTY_FOUNDER_SQUAD_SPAWNED =spawn_object(wpn_ak74:jup_b46_corps_spawn) =spawn_corpse(jup_b46_duty_founder:jup_b46_corps_spawn) =spawn_object(wpn_ak74u:jup_b46_corps_spawn) =spawn_corpse(jup_b46_duty_founder_squad_01:jup_b46_corps_spawn) =spawn_object(wpn_ak74u:jup_b46_corps_spawn) =spawn_corpse(jup_b46_duty_founder_squad_02:jup_b46_corps_spawn) =spawn_object(wpn_ak74:jup_b46_corps_spawn) =spawn_corpse(jup_b46_duty_founder_squad_03:jup_b46_corps_spawn) =spawn_object(wpn_abakan:jup_b46_corps_spawn) =spawn_object(wpn_abakan:jup_b46_corps_spawn) =spawn_corpse(jup_b46_duty_founder_squad_04:jup_b46_corps_spawn) =spawn_object(medkit:jup_b46_corps_spawn)%
on_info = {-JUP_B46_DUTY_FOUNDER_PDA_START =any_actor_has_item(jup_b46_duty_founder_pda)} %+JUP_B46_DUTY_FOUNDER_PDA_START =give_task(jup_b46_duty_founder_pda)%
on_info2 = {+JUP_B46_DUTY_FOUNDER_SQUAD_SPAWNED +JUP_B46_DUTY_FOUNDER_PDA_START} sr_idle@nil 

;client logic
[sr_idle@cl_jup_b46_sos_sound]
on_info2 = {=is_local_actor_relevant(50:jup_b46_spatial_bubble_zone)} %=play_sound(jup_b46_spatial_bubble_sos)%
on_info3 = {+JUP_B46_SPATIAL_BUBBLE_RUPTURED} sr_idle@cl_jup_b46_rupture %=stop_sound%

[sr_idle@cl_jup_b46_rupture] 
on_info = {+JUP_B46_DUTY_FOUNDER_PDA_START =any_actor_has_item(jup_b46_duty_founder_pda) =is_local_actor_relevant(50:jup_b46_spatial_bubble_zone)} %=play_sound(jup_b46_duty_founder_pda_diary)%
on_info2 = {+JUP_B46_DUTY_FOUNDER_SQUAD_SPAWNED +JUP_B46_DUTY_FOUNDER_PDA_START} sr_idle@nil 

[sr_idle@nil]