[logic]
active = sr_idle@determine_cl_sv
type = shared_with_cl_data

[sr_idle@determine_cl_sv]
on_info = {=isServer} sr_idle@sv_teleport_to
on_info2 = {=isClient} sr_idle@cl_teleport_to

;server logic
[sr_idle@sv_teleport_to] 
on_info = {+PRI_A17_TELEPORT_MILITARY_RECON} sr_idle@sv_teleportin

[sr_idle@sv_teleportin]
on_game_timer = 20 | %+PRI_A17_TELEPORT_STEP_1%
on_info = {+PRI_A17_TELEPORT_STEP_1} sr_idle@sv_teleport_post %=teleport_squad(pri_a17_recon_squad:pri_a17_recon_teleport)%

[sr_idle@sv_teleport_post]
on_info =  %=teleport_npc_by_story_id(pri_a17_military_captain_tarasov:pri_a17_taras_stay_idle)%
on_info2 = %=teleport_npc_by_story_id(pri_a17_military_prapor_valentyr:pri_a17_val_start)%
on_info3 = %=teleport_npc_by_story_id(pri_a17_military_lieutenant_podorojniy:pri_a17_pod_start)%
on_info4 = %=teleport_npc_by_story_id(pri_a17_military_sergeant_morozov:pri_a17_ice_stay)%
on_game_timer = 60 | %+PRI_A17_UI +PRI_A17_UI_CL%
on_info5 = {+PRI_A17_UI} sr_idle@nil %-PRI_A17_UI%

;client logic
[sr_idle@cl_teleport_to] 
on_info = {+PRI_A17_TELEPORT_MILITARY_RECON} sr_idle@cl_teleportin %=run_postprocess(fade_in) =disable_ui%

[sr_idle@cl_teleportin]
on_info = {+PRI_A17_TELEPORT_STEP_1} sr_idle@cl_teleport_post %=run_postprocess(black:8710:true) =xrmpe_teleport_local_actor(pri_a17_actor_teleport_stay:pri_a17_actor_teleport_look)%

[sr_idle@cl_teleport_post]
on_info = {+PRI_A17_UI_CL} sr_idle@nil %=stop_postprocess(8710) =enable_ui%

[sr_idle@nil]