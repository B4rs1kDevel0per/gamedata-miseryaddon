on_signal = pri_b305_cam2_pos | {-PRI_B305_KIRILOV_STRANGE_SIGNAL_DONE} %=play_sound(pri_b305_kirilov_strange_signal) +PRI_B305_KIRILOV_STRANGE_SIGNAL_DONE%
