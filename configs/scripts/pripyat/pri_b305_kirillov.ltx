on_info2  = {+PRI_B305_SECOND_CAM_END} animpoint@rest
meet = no_meet
on_info3 = {+PRI_B305_THIRD_CAM_GO} walker@strelok_operation_start %=teleport_npc(pri_a16_pri_b305_kirilov_strelok_operation_walk)%

[animpoint@rest]:animpoint@based
