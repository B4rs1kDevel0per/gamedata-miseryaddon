on_info = {+PRI_B305_THIRD_CAM_GO} walker@strelok_operation_start %=teleport_npc(pri_a16_pri_b305_kirilov_strelok_operation_walk)% 

;******************** < 4 > ***********************
[walker@strelok_operation_start]:walker@based
