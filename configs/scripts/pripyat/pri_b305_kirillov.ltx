on_info   = {+PRI_B305_KOVALSKIY_ASK_COORDINATES_DONE_END -PRI_B305_KIRILOV_GIVE_COORDINATES_DONE} %=play_sound(pri_b305_kirilov_give_coordinates) +PRI_B305_KIRILOV_GIVE_COORDINATES_DONE%
