out_restr = pri_a16_sr_noweap
on_info = {+PRI_B305_KIRILOV_ABOUT_STRELOK_1_DONE_END -PRI_B305_ACTOR_GO_DONE} %=play_sound(pri_b305_actor_go) +PRI_B305_ACTOR_GO_DONE%
on_signal = theme_end | remark@meet_kirilov_2 {-PRI_B305_ACTOR_GO_DONE_END} %+PRI_B305_ACTOR_GO_DONE_END%
