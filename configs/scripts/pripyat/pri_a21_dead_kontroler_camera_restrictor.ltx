[logic]
active = sr_idle@determine_cl_sv
type = shared_with_cl_data

[sr_idle@determine_cl_sv]
on_info = {=isServer} sr_idle@sv_pre_controler_dead_cutscene
on_info2 = {=isClient} sr_idle@cl_wait

;server logic
[sr_idle@sv_pre_controler_dead_cutscene]
on_info = {+PRI_A21_KONTRO_DEAD} sr_idle@sv_timer_before_cutscene 

[sr_idle@sv_timer_before_cutscene]
on_game_timer = 20 | sr_idle@sv_cutscene_start %+PRI_A21_CAM_WAIT =disable_ui =run_postprocess(fade_in:2023)%

[sr_idle@sv_cutscene_start]
on_game_timer = 10 | sr_idle@sv_wait %+PRI_A21_CAM_START =create_cutscene_actor_with_weapon(pri_a21_cutscene_actor:pri_a21_smart_terrain_cutscene_actor_spawn_point:0:306)%

[sr_idle@sv_wait]
on_info = {+PRI_A21_SENTRY_TASK_DONE} sr_idle@sv_cutscene_end

[sr_idle@sv_cutscene_end]
on_game_timer = 10 | sr_idle@sv_autosave %+PRI_A21_CAM_END_CL%

[sr_idle@sv_autosave]
on_info = {-PRI_A21_ONCE_AUTOSAVE_2} %+PRI_A21_ONCE_AUTOSAVE_2 =scenario_autosave(st_save_pri_a21_killed_controller)%
on_info2 = {+PRI_A21_ONCE_AUTOSAVE_2} sr_idle@nil

;client logic
[sr_idle@cl_wait]
on_info = {+PRI_A21_CAM_WAIT =local_actor_story_id(actor_degtyarev)} sr_idle@cl_wait2 %=disable_ui =run_postprocess(fade_in:2023)%

[sr_idle@cl_wait2]
on_info = {+PRI_A21_CAM_START} sr_cutscene@cl %=run_postprocess(black:2024:true)%

[sr_cutscene@cl]
global_cameffect = true
enable_ui_on_end = false
outdoor = true
point = pri_a21_kontro_dead_cutscene_actor_walk
look = pri_a21_kontro_dead_cutscene_actor_walk
cam_effector = scenario_cam\pripyat\pri_a21_scene_end_cam
on_game_timer = 10 | {-PRI_A21_PP_STOP} %+PRI_A21_PP_STOP =stop_postprocess(2023) =stop_postprocess(2024)%
on_signal = cameff_end | sr_idle@cl_cutscene_end %=run_postprocess(black:2021:true) +PRI_A21_SENTRY_TASK_DONE =xrmpe_teleport_local_actor(pri_a21_smart_terrain_cutscene_actor_spawn_point:pri_a21_smart_terrain_chasovoi_mad_walk)%
on_signal2 = cam_effector_stop | sr_idle@cl_cutscene_end %=run_postprocess(black:2021:true) +PRI_A21_SENTRY_TASK_DONE =xrmpe_teleport_local_actor(pri_a21_smart_terrain_cutscene_actor_spawn_point:pri_a21_smart_terrain_chasovoi_mad_walk)%
on_info = {+PRI_A21_CAM_END -PRI_A21_FADE_IN} %=run_postprocess(fade_in:2022) +PRI_A21_FADE_IN%
on_info2 = {+PRI_A21_CAM_STOP} %=stop_sr_cutscene%
on_info3 = {+PRI_A21_CUT_ACTOR_HIT} %=stop_sr_cutscene +PRI_A21_CAM_STOP +PRI_A21_CAM_END +PRI_A21_FADE_IN +PRI_A21_ACTOR_TALK_AFTER_DONE%

[sr_idle@cl_cutscene_end]
on_info = {+PRI_A21_CAM_END_CL} sr_idle@nil %=stop_postprocess(2021) =stop_postprocess(2022) =enable_ui%

[sr_idle@nil]

 