[logic]
active = sr_idle@determine_cl_sv
type = shared_with_cl_data

[sr_idle@determine_cl_sv]
on_info = {=isServer} sr_idle@sv_clean_jup
on_info2 = {=isClient} sr_idle@cl_wait

;server logic
[sr_idle@sv_clean_jup]
on_info = {=squad_exist(jup_b15_zulus_squad)} sr_idle@sv_spawn_vano %=remove_squad(jup_b15_zulus_squad)%, sr_idle@sv_spawn_vano

[sr_idle@sv_spawn_vano]
on_info = {-PRI_A15_VANO_OUT} sr_idle@sv_spawn_sokolov %=create_squad(pri_a16_vano_squad:pri_a16)%
on_info2 = {+PRI_A15_VANO_OUT} sr_idle@sv_spawn_sokolov

[sr_idle@sv_spawn_sokolov]
on_info = {-PRI_A15_SOKOLOV_OUT} sr_idle@sv_spawn_wanderer %=create_squad(pri_a16_sokolov_squad:pri_a16) +PRI_A16_SOKOLOV_ON_PRIPYAT%
on_info2 = {+PRI_A15_SOKOLOV_OUT} sr_idle@sv_spawn_wanderer

[sr_idle@sv_spawn_wanderer]
on_info = {-PRI_A15_WANDERER_OUT +JUP_B4_MONOLITH_SQUAD_IN_FREEDOM} sr_idle@sv_wait %=create_squad(pri_a16_wanderer_freedom_squad:pri_a16)%
on_info2 = {-PRI_A15_WANDERER_OUT +JUP_B4_MONOLITH_SQUAD_IN_DUTY} sr_idle@sv_wait %=create_squad(pri_a16_wanderer_dolg_squad:pri_a16)%
on_info3 = {+PRI_A15_WANDERER_OUT} sr_idle@sv_wait
on_info4 = {-JUP_B4_MONOLITH_SQUAD_IN_DUTY -JUP_B4_MONOLITH_SQUAD_IN_FREEDOM} %+JUP_B4_MONOLITH_SQUAD_IN_FREEDOM%

[sr_idle@sv_wait]
;затычка
on_info = {+PRI_A15_CUTSCENE_END} sr_idle@sv_fade

[sr_idle@sv_fade]
on_info = sr_idle@sv_after %=remove_squad(pri_a15_squad) =remove_squad(pri_a15_military_squad) =forward_game_time(0:20)% 

[sr_idle@sv_after]
on_info = {=squad_exist(pri_a16_wanderer_squad)} %=set_squad_goodwill(pri_a16_wanderer_squad:friend)% 
on_info2 = sr_idle@sv_wait_for_end

[sr_idle@sv_wait_for_end]
on_game_timer = 30 | sr_idle@nil %+PRI_A16_KOVALSKI_START =spawn_corpse(sim_default_monolith_2:pri_a15_monolith_dead_stand:0)%

;client logic
[sr_idle@cl_wait]
on_info = {+PRI_A15_CUTSCENE_GO} sr_cutscene@cl_start
on_info2 = {+PRI_A15_CUTSCENE_END} sr_idle@sv_fade

[sr_cutscene@cl_start]
point = pri_a15_actor_walk
look = pri_a15_actor_look
cam_effector = pri_a15_cameffector
on_signal = cameff_end | sr_idle@cl_wait_for_end %=xrmpe_teleport_local_actor(pri_a15_actor_start_walk:pri_a15_actor_start_look) +PRI_A15_CUTSCENE_END =run_postprocess(black:3009:true)%
enable_ui_on_end = false
outdoor = true

[sr_idle@cl_wait_for_end]
on_info = {!black_screen -PRI_A16_READY_TALK} %+PRI_A16_READY_TALK%
on_info2 = {+PRI_A16_KOVALSKI_START} sr_idle@nil %=enable_ui =stop_postprocess(3009)%

[sr_idle@nil]
