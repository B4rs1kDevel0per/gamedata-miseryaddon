[logic]
active = sr_idle@determine_cl_sv
type = shared_with_cl_data

[sr_idle@determine_cl_sv]
on_info = {=isServer} sr_idle@sv_run_black
on_info2 = {=isClient} sr_idle@cl_run_black

;server logic
[sr_idle@sv_run_black]
on_info = sr_idle@sv_prestart %=stop_surge =set_counter(pri_a15_squad_count:5) =create_squad(pri_a15_squad:pri_a15) =create_squad(pri_a15_military_squad:pri_a15)%

[sr_idle@sv_prestart]
on_game_timer = 5 | sr_idle@sv_start %+PRI_A15_CUTSCENE_WAIT%

[sr_idle@sv_start]
on_info = {+PAS_B400_DONE} sr_idle@sv_give_info
on_info2 = {-PAS_B400_DONE} sr_idle@nil %+PRI_A15_CUTSCENE_END%   

[sr_idle@sv_give_info]
on_info = { -PRI_A15_VANO_OUT -PRI_A15_SOKOLOV_OUT -PRI_A15_ZULUS_OUT -PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_ALL_ALIVE%

on_info2 = { +PRI_A15_VANO_OUT -PRI_A15_SOKOLOV_OUT -PRI_A15_ZULUS_OUT -PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_1_VANO%
on_info3 = { -PRI_A15_VANO_OUT +PRI_A15_SOKOLOV_OUT -PRI_A15_ZULUS_OUT -PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_1_SOKOLOV%
on_info4 = { -PRI_A15_VANO_OUT -PRI_A15_SOKOLOV_OUT +PRI_A15_ZULUS_OUT -PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_1_ZULUS%
on_info5 = { -PRI_A15_VANO_OUT -PRI_A15_SOKOLOV_OUT -PRI_A15_ZULUS_OUT +PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_1_WANDERER%

on_info6 = { +PRI_A15_VANO_OUT +PRI_A15_SOKOLOV_OUT -PRI_A15_ZULUS_OUT -PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_2_VANO_SOKOLOV%
on_info7 = { +PRI_A15_VANO_OUT -PRI_A15_SOKOLOV_OUT +PRI_A15_ZULUS_OUT -PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_2_VANO_ZULUS%
on_info8 = { +PRI_A15_VANO_OUT -PRI_A15_SOKOLOV_OUT -PRI_A15_ZULUS_OUT +PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_2_VANO_WANDERER%
on_info9 = { -PRI_A15_VANO_OUT +PRI_A15_SOKOLOV_OUT +PRI_A15_ZULUS_OUT -PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_2_SOKOLOV_ZULUS%
on_info10 = { -PRI_A15_VANO_OUT +PRI_A15_SOKOLOV_OUT -PRI_A15_ZULUS_OUT +PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_2_SOKOLOV_WANDERER%
on_info11 = { -PRI_A15_VANO_OUT -PRI_A15_SOKOLOV_OUT +PRI_A15_ZULUS_OUT +PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_2_ZULUS_WANDERER%

on_info12 = { +PRI_A15_VANO_OUT +PRI_A15_SOKOLOV_OUT +PRI_A15_ZULUS_OUT -PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_3_WANDERER_ALIVE%
on_info13 = { +PRI_A15_VANO_OUT +PRI_A15_SOKOLOV_OUT -PRI_A15_ZULUS_OUT +PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_3_ZULUS_ALIVE%
on_info14 = { +PRI_A15_VANO_OUT -PRI_A15_SOKOLOV_OUT +PRI_A15_ZULUS_OUT +PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_3_SOKOLOV_ALIVE%
on_info15 = { -PRI_A15_VANO_OUT +PRI_A15_SOKOLOV_OUT +PRI_A15_ZULUS_OUT +PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_3_VANO_ALIVE%

on_info16 = { +PRI_A15_VANO_OUT +PRI_A15_SOKOLOV_OUT +PRI_A15_ZULUS_OUT +PRI_A15_WANDERER_OUT} sr_idle@sv_spawn_military %+PRI_A15_ALL_DEAD%

[sr_idle@sv_spawn_military]
on_info = sr_idle@sv_spawn_vano %=create_squad_member(pri_a15_military_2:pri_a15_military_squad:pri_a15_military_2_spawn) =create_squad_member(pri_a15_military_3:pri_a15_military_squad:pri_a15_military_3_spawn) =create_squad_member(pri_a15_military_4:pri_a15_military_squad:pri_a15_military_4_spawn)%

[sr_idle@sv_spawn_vano]
on_info = {-PRI_A15_VANO_OUT} sr_idle@sv_spawn_sokolov %=create_squad_member(pri_a15_vano:pri_a15_squad:pri_a15_vano_spawn) =inc_counter(pri_a15_squad_count)%
on_info2 = {+PRI_A15_VANO_OUT} sr_idle@sv_spawn_sokolov

[sr_idle@sv_spawn_sokolov]
on_info = {-PRI_A15_SOKOLOV_OUT} sr_idle@sv_spawn_zulus %=create_squad_member(pri_a15_sokolov_scene:pri_a15_squad:pri_a15_sokolov_spawn) =inc_counter(pri_a15_squad_count)%
on_info2 = {+PRI_A15_SOKOLOV_OUT} sr_idle@sv_spawn_zulus

[sr_idle@sv_spawn_zulus]
on_info = {-PRI_A15_ZULUS_OUT} sr_idle@sv_spawn_wanderer %=create_squad_member(pri_a15_zulus:pri_a15_squad:pri_a15_zulus_spawn) =inc_counter(pri_a15_squad_count)%
on_info2 = {+PRI_A15_ZULUS_OUT} sr_idle@sv_spawn_wanderer

[sr_idle@sv_spawn_wanderer]
on_info = {-PRI_A15_WANDERER_OUT} sr_idle@sv_count_squad %=create_squad_member(pri_a15_wanderer:pri_a15_squad:pri_a15_wanderer_spawn) =inc_counter(pri_a15_squad_count)%
on_info2 = {+PRI_A15_WANDERER_OUT} sr_idle@sv_count_squad

[sr_idle@sv_count_squad]
on_info = {=ClientsConnectedToActors !counter_greater(pri_a15_squad_count:0)} sr_idle@sv_timeout
on_game_timer = 1800 | {!counter_greater(pri_a15_squad_count:0)} sr_idle@sv_start_cam %=stop_surge%

[sr_idle@sv_timeout]
on_game_timer = 50 | sr_idle@sv_start_cam %=stop_surge%

[sr_idle@sv_start_cam]
on_game_timer = 20 | sr_idle@sv_wait %+PRI_A15_CUTSCENE_GO =update_npc_logic(pri_a15_actor:pri_a15_vano:pri_a15_sokolov_scene:pri_a15_zulus:pri_a15_wanderer:pri_a15_military_tarasov:pri_a15_military_2:pri_a15_military_3:pri_a15_military_4) =update_obj_logic(pri_a15_exit)%

[sr_idle@sv_wait]
on_info = {+PRI_A15_CUTSCENE_END} sr_idle@sv_end
on_info2 = {+PRI_A15_DOOR_BREAK -PRI_A15_DOOR_BREAK_PLAY} %=anim_obj_forward(pri_a15_door) +PRI_A15_DOOR_BREAK_PLAY%

[sr_idle@sv_end]
on_game_timer = 75 | sr_idle@nil %+PRI_A15_CUTSCENE_END_CL%
on_info = {+PRI_A16_KOVALSKI_START} sr_idle@nil

;client logic
[sr_idle@cl_run_black]
on_info = sr_idle@cl_prestart %=disable_ui =run_postprocess(black:3009:true)%

[sr_idle@cl_prestart]
on_info = {+PRI_A15_CUTSCENE_WAIT} sr_idle@cl_start %=xrmpe_teleport_local_actor(pri_a15_actor_walk:pri_a15_actor_look)%

[sr_idle@cl_start]
on_info = {+PAS_B400_DONE} sr_idle@cl_wait
on_info2 = {-PAS_B400_DONE} sr_idle@nil %=xrmpe_teleport_local_actor(pri_a15_actor_start_walk:pri_a15_actor_start_look) =stop_postprocess(3009) =enable_ui%   

[sr_idle@cl_wait]
on_info = {+PRI_A15_CUTSCENE_GO} sr_idle@cl_wait %=stop_postprocess(3009)%

[sr_idle@cl_wait2]
on_info = {+PRI_A15_CUTSCENE_END} sr_idle@cl_wait3 %=run_postprocess(fade_to_black_9_sec)%

[sr_idle@cl_wait3]
on_info = {+PRI_A15_CUTSCENE_END_CL} sr_idle@nil %=run_postprocess(black:3009:true)%

[sr_idle@nil]
