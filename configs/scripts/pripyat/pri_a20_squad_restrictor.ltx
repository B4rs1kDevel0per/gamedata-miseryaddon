[logic]
active = sr_idle@determine_cl_sv
type = shared_with_cl_data

[sr_idle@determine_cl_sv]
on_info = {=isServer} sr_idle@sv_dead_squad_cutscene
on_info2 = {=isClient} sr_idle@cl_wait

;server logic
[sr_idle@sv_dead_squad_cutscene]
on_info = {+PRI_A20_SQUAD_ATTACK_CAM +PRI_A20_ACTOR_IN_ZONE} sr_idle@sv_timer_before_fade %=create_cutscene_actor_with_weapon(pri_a20_cutscene_actor_squad:pri_b35_mercs_leader_rendevous_look:0:0)%

[sr_idle@sv_timer_before_fade]
on_game_timer = 20 | sr_idle@sv_fade %+PRI_A20_SQUAD_ATTACK_CAM_FADE =teleport_npc_by_story_id(pri_a20_cutscene_actor_squad:pri_a20_deadman_military_3_im)%

[sr_idle@sv_fade]
on_game_timer = 20 | sr_idle@sv_wait %+PRI_A20_SQUAD_ATTACK_CAM_START =run_postprocess(black:2023:true)%

[sr_idle@sv_wait]
on_info = {+PRI_A20_CAM_STOP_CL} sr_idle@sv_cutscene_end %+PRI_A20_CAM_END_CL%

[sr_idle@sv_cutscene_end]
on_game_timer = 10 | sr_idle@sv_autosave

[sr_idle@sv_autosave]
on_info = {-PRI_A20_ONCE_AUTOSAVE} %+PRI_A20_ONCE_AUTOSAVE =scenario_autosave(st_save_pri_a20_found_dead_recon)%
on_info2 = {+PRI_A20_ONCE_AUTOSAVE} sr_idle@nil

;client logic
[sr_idle@cl_wait]
on_info = {+PRI_A20_SQUAD_ATTACK_CAM =local_actor_story_id(actor_degtyarev) =player_in_zone(pri_a20_squad_task_complete_restrictor)} sr_idle@cl_timer_before_fade %+PRI_A20_ACTOR_IN_ZONE%

[sr_idle@cl_timer_before_fade]
on_info = {+PRI_A20_SQUAD_ATTACK_CAM_FADE} sr_idle@cl_fade %=disable_ui =run_postprocess(fade_in:2022)%

[sr_idle@cl_fade]
on_info = {+PRI_A20_SQUAD_ATTACK_CAM_START} sr_cutscene@cl_cut %=run_postprocess(black:2023:true)%

[sr_cutscene@cl_cut]
global_cameffect = true
enable_ui_on_end = false
outdoor = true
point = pri_a20_squad_find_actor_teleport_walk
look = pri_a20_squad_find_actor_teleport_look
cam_effector = scenario_cam\pripyat\pri_a20_dead_recon_squad
on_signal = cameff_end | {-ZAT_A23_ACTOR_HAS_GAUSS_RIFLE_DOCUMENTATION} sr_idle@cl_cutscene_end_postprocess %+PRI_A20_CAM_STOP_CL =xrmpe_teleport_local_actor(pri_a20_cutscene_actor_walk_check_squad:pri_a20_cutscene_actor_look_check_squad) +PRI_A20_TALK_WITH_COLONEL_COMPLETE%, sr_idle@cl_cutscene_end_postprocess %+PRI_A20_CAM_STOP_CL =xrmpe_teleport_local_actor(pri_a20_cutscene_actor_walk_squad:pri_a20_deadman_military_3_im) +PRI_A20_TALK_WITH_COLONEL_COMPLETE +PRI_A21_TASK_GIVE_FROM_A20%
on_signal2 = cam_effector_stop | {-ZAT_A23_ACTOR_HAS_GAUSS_RIFLE_DOCUMENTATION} sr_idle@cl_cutscene_end_postprocess %+PRI_A20_CAM_STOP_CL =xrmpe_teleport_local_actor(pri_a20_cutscene_actor_walk_check_squad:pri_a20_cutscene_actor_look_check_squad) +PRI_A20_TALK_WITH_COLONEL_COMPLETE%, sr_idle@cl_cutscene_end_postprocess %+PRI_A20_CAM_STOP_CL =xrmpe_teleport_local_actor(pri_a20_cutscene_actor_walk_squad:pri_a20_deadman_military_3_im) +PRI_A20_TALK_WITH_COLONEL_COMPLETE +PRI_A21_TASK_GIVE_FROM_A20%
on_game_timer = 10 | {-PRI_A20_PP_STOP} %+PRI_A20_PP_STOP =stop_postprocess(2022) =stop_postprocess(2023)%
on_info = {+PRI_A20_SQUAD_CAM_END -PRI_A20_FADE_IN} %=run_postprocess(fade_in:2024) +PRI_A20_FADE_IN%
on_info2 = {+PRI_A20_CAM_END -PRI_A20_FADE_2_IN} %=stop_sr_cutscene =run_postprocess(black:2021:true) +PRI_A20_FADE_2_IN%
on_info3 = {+PRI_A20_CUT_ACTOR_HIT} %=stop_sr_cutscene =run_postprocess(black:2021:true) +PRI_A20_FADE_2_IN +PRI_A20_CAM_END +PRI_A20_SQUAD_CAM_END +PRI_A20_FADE_IN +PRI_A20_SQUAD_CUTSCENE_ACTOR_TALK +PRI_A20_SQUAD_CUTSCENE_ACTOR_TALK_COMPLETE +PRI_A20_SQUAD_CUTSCENE_ACTOR_TALK_2 +PRI_A20_SQUAD_CUTSCENE_ACTOR_TALK_2_COMPLETE%

[sr_idle@cl_cutscene_end_postprocess]
on_info = {+PRI_A20_CAM_END_CL} sr_idle@nil %=stop_postprocess(2021) =enable_ui%

[sr_idle@nil]

