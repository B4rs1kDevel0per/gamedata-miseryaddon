; =============================================================================
; zat_b40_mercs.ltx — адаптация Misery 2.x → xrMPE
;
; Изменения относительно Misery:
;   1. known_info → known_flags  (xrMPE не использует инфопоршни NPC)
;      Имена флагов внутри секции — ВЕРХНИЙ РЕГИСТР (требование xrMPE story_flags)
;   2. logic@zat_b40_mercs_gen.suitable — убрана двойная логика Мизери
;      (squad_exist + npc_community), оставлен вариант vanilla xrMPE:
;      suitable = {=npc_community(killer)} true
;   3. on_sound: "any_actor" → "actor" (vanilla xrMPE xr_hear не знает тег "any_actor"
;      в on_sound-строке; "actor" — стандартный тег для звука актора)
;   4. walker@zat_b40_mercs_gen: def_state_moving = sprint (vanilla xrMPE)
;      В Мизери стоит rush — оставлено на выбор, см. комментарий ниже
;   5. camper@zat_b40_surge_gen: структура из vanilla xrMPE (нет отдельного
;      walker@zat_b40_surge_gen — surge идёт через camper-секции)
;   6. Флаги в условиях и эффектах — ВЕРХНИЙ РЕГИСТР (xrMPE story_flags)
;   7. Секции remark@zat_b40_warning_* — раскомментированы (в исходнике Мизери
;      они закомментированы; в vanilla xrMPE они есть и нужны для warning-цикла)
;   8. КРАШ guard_11..16 / beh@ — ИСПРАВЛЕНО (см. подробный комментарий ниже)
;   9. meet@, animpoint-секции из Мизери — сохранены БЕЗ изменений
;
; СПОРНЫЕ МОМЕНТЫ закомментированы тегом ; ???
; =============================================================================

; =============================================================================
; !! ВАЖНО: схема "beh" — Мизери-эксклюзив, в vanilla xrMPE не существует !!
;
; В gulag_general.script есть таблица job_type_by_scheme:
;   walker → path_job, camper → path_job, remark → point_job, ...
;   "beh" в ней ОТСУТСТВУЕТ.
;
; Если guard_11..16 прописаны в [exclusive] секции zat_b40_smart_terrain.ltx,
; то при загрузке spawns движок вызывает load_jobs() → add_exclusive_job() →
; scheme = "beh" → job_type = nil → alife_task никогда не устанавливается →
; смерть на строке 529 smart_terrain.script:
;   "attempt to index field 'alife_task' (a nil value)"
;
; РЕШЕНИЕ: logic@guard_11..16 переключены на walker@ с теми же путями.
; Поведение beh (sleep/rain/surge) теряется — NPC будут просто патрулировать.
;
; ЕСЛИ хочешь вернуть beh-поведение (sleep/rain/surge) для guard_11..16,
; нужно одно из двух:
;   A) Портировать схему beh в xrMPE (добавить "beh" в job_type_by_scheme
;      в gulag_general.script и написать xr_beh.script)
;   B) Убрать guard_11..16 из [exclusive] в smart_terrain.ltx совсем
;      (тогда они будут "симуляционными" NPC без логики, не крашатся)
;
; Все beh@-секции ниже закомментированы — они не нужны без схемы.
; =============================================================================

; ---- general -----------------------------------------------------------------

[hit@zat_b40_mercs_hit_gen]
on_info = {=fighting_actor} %+ZAT_B40_MERC_IN_COMBAT%

[camper@zat_b40_mercs_gen]
radius = 50
def_state_moving = sprint
combat_ignore_cond = true
on_actor_dist_le1 = 100 | %+ZAT_B40_ACTOR_FIND_MER_CAMP%
on_actor_dist_le2 = 50  | {+ZAT_B40_WORNING_TIME_OUT} %+ZAT_B40_MERC_IN_COMBAT%
on_actor_dist_le_nvis = 10 | {+ZAT_B40_WORNING_TIME_OUT} %+ZAT_B40_MERC_IN_COMBAT%
corpse_detection_enabled = false
; "actor" — стандартный тег xrMPE для звука актора в on_sound.
; Мизери использовала "any_actor" — в ванильном xrMPE этот тег поддерживается
; только в check_npc_name-контексте, но НЕ как on_sound-тег. Оставлен "actor".
on_sound = actor|WPN_shoot|60|0.2| %+ZAT_B40_MERC_IN_COMBAT%
;on_sound2 = any|MST_die|15|0.63| %+ZAT_B40_MERC_IN_COMBAT%

[walker@zat_b40_mercs_gen]
; ??? Мизери: def_state_moving = rush. Vanilla xrMPE: sprint.
; sprint агрессивнее выглядит при патруле, rush мягче.
; Если хочешь поведение Мизери — замени sprint на rush.
def_state_moving = sprint
def_state_standing = hide

[remark@zat_b40_danger_gen]
anim = hide
target = story | actor
on_info = {=see_actor} %+ZAT_B40_MERC_COMBAT_FIND_ACTOR%
on_info2 = {-ZAT_B40_CALL_TO_FIGHT_SAD} %=play_sound(zat_b40_merc_combat) +ZAT_B40_CALL_TO_FIGHT_SAD%
on_game_timer = 600 | %+ZAT_B40_MERC_COMBAT_FIND_ACTOR%

[remark@zat_b40_warning_gen]
anim = guard_na
target = story | actor
combat_ignore_cond = true
corpse_detection_enabled = false
on_sound = actor|WPN_shoot|10000|0.0| %+ZAT_B40_MERC_IN_COMBAT%
on_info = %=play_sound(zat_b40_merc_go_away)%
on_signal = theme_end | %+ZAT_B40_START_WORNING_TIME%

[camper@zat_b40_surge_gen]:camper@zat_b40_mercs_gen
def_state_standing = sit_knee
out_restr = zat_surge_hide_b40
combat_ignore_cond = {-ZAT_B40_MERC_IN_COMBAT} true, false
on_info3 = {-ZAT_B40_CALL_TO_FIGHT_SAD +ZAT_B40_MERC_IN_COMBAT} %=play_sound(zat_b40_merc_combat) +ZAT_B40_CALL_TO_FIGHT_SAD%

; ---- logic -------------------------------------------------------------------

[logic@zat_b40_mercs_gen]
; Мизери имела двойное suitable:
;   {=squad_exist(...) =npc_community(killer)} true, {!squad_exist(...)} true
; Это избыточно — результат всегда true если NPC из нужной фракции.
; Vanilla xrMPE использует просто {=npc_community(killer)} true — оставлено.
suitable = {=npc_community(killer)} true
prior = 200
on_hit = hit@zat_b40_mercs_hit_gen

[logic@zat_b40_guard_leader_01]:logic@zat_b40_mercs_gen
suitable = {=check_npc_name(zat_b40_merc_squad_leader_1)} true
prior = 300
active = walker@zat_b40_guard_leader_01
; known_info → known_flags (xrMPE)
known_flags = known_flags@zat_b40_guard_leader_01

[logic@zat_b40_guard_leader_02]:logic@zat_b40_mercs_gen
suitable = {=check_npc_name(zat_b40_merc_squad_leader_2)} true
prior = 300
active = walker@zat_b40_guard_leader_02
known_flags = known_flags@zat_b40_guard_leader_02

[logic@zat_b40_guard_01]:logic@zat_b40_mercs_gen
active = walker@zat_b40_guard_01

[logic@zat_b40_guard_02]:logic@zat_b40_mercs_gen
active = walker@zat_b40_guard_02

[logic@zat_b40_guard_03]:logic@zat_b40_mercs_gen
active = walker@zat_b40_guard_03

[logic@zat_b40_guard_04]:logic@zat_b40_mercs_gen
active = walker@zat_b40_guard_04

[logic@zat_b40_guard_05]:logic@zat_b40_mercs_gen
active = walker@zat_b40_guard_05

[logic@zat_b40_guard_06]:logic@zat_b40_mercs_gen
active = walker@zat_b40_guard_06

[logic@zat_b40_guard_07]:logic@zat_b40_mercs_gen
active = walker@zat_b40_guard_07

[logic@zat_b40_guard_08]:logic@zat_b40_mercs_gen
active = walker@zat_b40_guard_08

; Эти две секции из Мизери (нет в vanilla xrMPE).
; suitable переопределяет родительский — NPC без squad подхватывают walker лидеров.
[logic@zat_b40_guard_09]:logic@zat_b40_mercs_gen
suitable = {!squad_exist(zat_b40_merc_squad)} true
