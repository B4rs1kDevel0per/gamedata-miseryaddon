[logic]
active = sr_idle@determine_cl_sv
type = shared_with_cl_data

[sr_idle@determine_cl_sv]
on_info = {=isServer} sr_idle@sv_wait
on_info2 = {=isClient} sr_idle@cl_play_intro

;server logic
[sr_idle@sv_wait]
on_info = {+ZAT_A1_TUTORIAL_STOP -ZAT_B101_GIVE_TASK +ZAT_A1_GAME_START} sr_idle@sv_save %=give_task(zat_b101_heli_5_crash) +ZAT_B101_GIVE_TASK =give_task(jup_b8_heli_4_crash) +JUP_B8_GIVE_TASK =give_task(zat_b28_heli_3_crash) =give_task(zat_b100_heli_2_crash) =give_task(jup_b9_heli_1_crash) +JUP_B9_GIVE_TASK =damage_actor_items_on_start%

[sr_idle@sv_save]
on_info = {-ZAT_A1_GAME_START_SAVED} %+ZAT_A1_GAME_START_SAVED =set_start_squad_relation =scenario_autosave(st_save_zat_a1_game_start)%
on_info2 = {+ZAT_A1_GAME_START_SAVED} sr_idle@sv_wait_heli_5_cut

[sr_idle@sv_wait_heli_5_cut]
on_info = {+ZAT_B101_HELI_5_SEARCHING -ZAT_B101_HELI_5_SEARCHED} sr_idle@sv_heli_5_cut_spawn

[sr_idle@sv_heli_5_cut_spawn]
on_game_timer = 20 | sr_idle@sv_heli_5_cut_start %+ZAT_B101_HELI_5_CUT_SPAWN =create_cutscene_actor_with_weapon(zat_b101_actor_visual_stalker:zat_b101_actor_visual_stalker_walk:0:45)%

[sr_idle@sv_heli_5_cut_start]
on_game_timer = 30 | sr_idle@sv_heli_5_cut_end %+ZAT_B101_HELI_5_CUT_START +PLAY_SOUND_HELI_5%

[sr_idle@sv_heli_5_cut_end]
on_info = {+ZAT_B101_HELI_5_CUT_END} sr_idle@sv_end

[sr_idle@sv_end]
on_game_timer = 10 | %+ZAT_B101_HELI_5_SEARCHED%
on_info = {+ZAT_B101_HELI_5_SEARCHED} sr_idle@sv_save2

[sr_idle@sv_save2]
on_info = {+ZAT_B101_HELI_5_SEARCHED -SAVE_ZAT_B101_SEARCHED_HELI_5} %+SAVE_ZAT_B101_SEARCHED_HELI_5 =scenario_autosave(st_save_zat_b101_searched_heli_5)%
on_info2 = {+SAVE_ZAT_B101_SEARCHED_HELI_5} sr_idle@nil

;client logic
[sr_idle@cl_play_intro]
on_info = {+GAME_STARTED -zat_a1_tutorial_start} sr_idle@cl_wait_tutorial_end %=run_tutorial(intro_game) +zat_a1_tutorial_start%

[sr_idle@cl_wait_tutorial_end]
on_info = {!has_active_tutorial -ZAT_A1_TUTORIAL_STOP} %+ZAT_A1_TUTORIAL_STOP%
on_info2 = {+ZAT_A1_TUTORIAL_STOP} sr_idle@cl_set_active_task %=stop_tutorial%

[sr_idle@cl_set_active_task]
on_info = {+JUP_B9_GIVE_TASK} sr_idle@cl_wait_heli_5_cut %=set_active_task(zat_b28_heli_3_crash)%

[sr_idle@cl_wait_heli_5_cut]
on_info = {=local_actor_story_id(actor_degtyarev) +ZAT_B101_HELI_5_SEARCHING -ZAT_B101_HELI_5_SEARCHED} sr_idle@cl_heli_5_cut_spawn %=disable_ui =run_postprocess(fade_in:8010)%, {!local_actor_story_id(actor_degtyarev)} sr_idle@nil

[sr_idle@cl_heli_5_cut_spawn]
on_info = {+ZAT_B101_HELI_5_CUT_SPAWN} sr_idle@cl_heli_5_cut_start %=run_postprocess(black:8011:true)%

[sr_idle@cl_heli_5_cut_start]
on_info = {+ZAT_B101_HELI_5_CUT_START} sr_cutscene@cl_heli_5_cut %=stop_postprocess(8010) =stop_postprocess(8011)%

[sr_cutscene@cl_heli_5_cut]
point = zat_b101_actor_visual_stalker_walk
look = zat_b101_actor_visual_stalker_look
global_cameffect = true
enable_ui_on_end = false
outdoor = true
cam_effector = scenario_cam\zaton\zat_b101_heli_5_camera
on_signal = cameff_end | sr_idle@cl_end %+ZAT_B101_HELI_5_CUT_END =run_postprocess(black:8013:true)%
on_signal2 = cam_effector_stop | sr_idle@cl_end %+ZAT_B101_HELI_5_CUT_END =run_postprocess(black:8112:true)%
on_info = {+ZAT_B101_HELI_5_SOUND -ZAT_B101_HELI_AFTER_CAMERA_FADE} %+ZAT_B101_HELI_AFTER_CAMERA_FADE =run_postprocess(fade_in:8012)%
on_info2 = {+ZAT_B101_JUP_B8_CAMERA_ONE_STOP -JUP_B8_HELI_4_SEARCHING} %=stop_sr_cutscene%
on_info3 = {+ZAT_B101_JUP_B8_CAMERA_BOTH_STOP} %=stop_sr_cutscene%
on_info4 = {+ZAT_B101_ACTOR_HIT} %=stop_sr_cutscene =run_postprocess(black:8013:true)% 

[sr_idle@cl_end]
on_info = {+ZAT_B101_HELI_5_SEARCHED} sr_idle@nil %=stop_postprocess(8012) =stop_postprocess(8013) =enable_ui =xrmpe_teleport_local_actor(zat_b101_actor_visual_stalker_walk:zat_b101_actor_visual_stalker_look)%

[sr_idle@nil]
