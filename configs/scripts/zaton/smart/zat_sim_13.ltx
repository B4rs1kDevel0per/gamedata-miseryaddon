max_population = 1
spawn_point = zat_sim_13_spawn_point 
respawn_params = respawn@zat_sim_13   

[respawn@zat_sim_13]
spawn_bandit@novice
spawn_bandit@advanced
spawn_bandit@master

[spawn_bandit@novice]
