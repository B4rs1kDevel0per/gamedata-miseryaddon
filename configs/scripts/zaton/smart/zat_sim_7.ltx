[smart_terrain];zat_sim_7
squad_id = 4
max_population = 1
respawn_params = respawn@zat_sim_7  

[respawn@zat_sim_7]
spawn_bloodsucker
spawn_gigant
spawn_dog
spawn_pseudodog
spawn_boar
spawn_flesh

[spawn_bloodsucker]
spawn_squads = simulation_bloodsucker_zat_sim_7 
spawn_num = {+ZAT_B38_FAILED} 2, {+ZAT_B57_BLOODSUCKER_LAIR_CLEAR} 0, 1

[spawn_gigant]
spawn_squads = simulation_gigant_zat_sim_7, simulation_snork, simulation_pseudodog
spawn_num = {+ZAT_B57_BLOODSUCKER_LAIR_CLEAR} 1, 0

[spawn_pseudodog]
spawn_squads = simulation_pseudodog, simulation_dog
spawn_num = {+ZAT_B57_BLOODSUCKER_LAIR_CLEAR} 1, 0

[spawn_dog]
spawn_squads = simulation_dog
spawn_num = {+ZAT_B57_BLOODSUCKER_LAIR_CLEAR} 1, 0

[spawn_boar]
spawn_squads = simulation_boar, simulation_flesh
spawn_num = {+ZAT_B57_BLOODSUCKER_LAIR_CLEAR} 1, 0

[spawn_flesh]
spawn_squads = simulation_flesh, simulation_boar
spawn_num = {+ZAT_B57_BLOODSUCKER_LAIR_CLEAR} 1, 0