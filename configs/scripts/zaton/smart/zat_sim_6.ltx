[smart_terrain];zat_sim_6
squad_id = 5
max_population = 1
respawn_only_smart = true
respawn_params = respawn@zat_sim_6   

[respawn@zat_sim_6]
spawn_dog
spawn_pseudodog
spawn_boar
spawn_flesh
spawn_bloodsucker

[spawn_bloodsucker]
spawn_squads = simulation_bloodsucker_zat_sim_6
spawn_num = {+ZAT_B38_FAILED} 2, {+ZAT_B57_BLOODSUCKER_LAIR_CLEAR} 0, 1

[spawn_pseudodog]
spawn_squads = simulation_pseudodog, simulation_gigant_zat_sim_6, simulation_snork
spawn_num = {+ZAT_B57_BLOODSUCKER_LAIR_CLEAR} 1, 0

[spawn_dog]
spawn_squads = simulation_dog, simulation_dog, simulation_pseudodog
spawn_num = {+ZAT_B57_BLOODSUCKER_LAIR_CLEAR} 2, 0

[spawn_boar]
spawn_squads = simulation_boar
spawn_num = {+ZAT_B57_BLOODSUCKER_LAIR_CLEAR} 2, 0

[spawn_flesh]
spawn_squads = simulation_flesh
spawn_num = {+ZAT_B57_BLOODSUCKER_LAIR_CLEAR} 2, 0