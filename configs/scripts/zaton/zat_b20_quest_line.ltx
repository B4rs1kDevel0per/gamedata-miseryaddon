[logic]
active = sr_idle@determine_cl_sv
type = shared_with_cl_data

[sr_idle@determine_cl_sv]
on_info = {=isServer} sr_idle@sv_start
on_info2 = {=isClient} sr_idle@cl_start

;server logic
[sr_idle@sv_start]
on_info = {+ZAT_B20_PLATEAU_WAY_STARTED} sr_idle@sv_play %=give_task(zat_b20_plateau_way)%
on_info2 = {=any_actor_in_zone(zat_b20_sr_actor_cross_the_teleport)} sr_idle@sv_wait_to_fallen %+ZAT_B20_PLATEAU_WAY_DONE%
on_info3 = {=dist_to_actor_le(65)} sr_idle@sv_play %=give_task(zat_b20_plateau_way)%

[sr_idle@sv_play]
on_info = {+ZAT_B20_PLATEAU_WAY_GO} sr_idle@sv_timer
on_info2 = {+ZAT_B20_PLATEAU_WAY_DONE} sr_idle@nil
on_info3 = {=any_actor_in_zone(zat_b20_sr_actor_cross_the_teleport)} sr_idle@sv_wait_to_fallen %+ZAT_B20_PLATEAU_WAY_DONE%

[sr_idle@sv_timer]
on_game_timer = 10 | sr_idle@sv_create %+ZAT_B20_PLATEAU_WAY_CUT_WAIT1 =clear_smart_terrain(zat_b20_smart_terrain)% 
on_info = {+ZAT_B18_NOAH_DEAD} sr_idle@nil

[sr_idle@sv_create]
on_game_timer = 20 | sr_idle@sv_wait1 %+ZAT_B20_PLATEAU_WAY_CUT_WAIT2 =xrmpe_teleport_relevant_actors(zat_b18_noah:zat_b20_smart_terrain_actor_spawn_walk:zat_b20_smart_terrain_actor_spawn_look:10) =create_squad(zat_b20_noah_teleport_squad:zat_b20_smart_terrain) =create_cutscene_actor_with_weapon(zat_b20_actor:zat_b20_smart_terrain_actor_spawn_walk:0:0:3)%
on_info = {+ZAT_B18_NOAH_DEAD} sr_idle@nil

[sr_idle@sv_wait1]
on_info = {+ZAT_B20_STOP_POSTPROCESS} sr_idle@sv_info_timer 
on_info2 = {+ZAT_B18_NOAH_DEAD} sr_idle@nil

[sr_idle@sv_info_timer]
on_game_timer = 30 | sr_idle@sv_wait3 %+ZAT_B20_PLATEAU_WAY_CUT_START%
on_info = {+ZAT_B18_NOAH_DEAD} sr_idle@nil

[sr_idle@sv_wait3]
on_info = {+ZAT_B20_PLATEAU_WAY_KNOWN} sr_idle@sv_hour

[sr_idle@sv_hour]
on_game_timer = 3600 | sr_idle@sv_hour_fail
on_info = {=any_actor_in_zone(zat_b20_sr_actor_cross_the_teleport)} sr_idle@sv_play_snd %+ZAT_B20_PLATEAU_WAY_DONE%
on_info2 = {-ZAT_B20_AUTOSAVE} %+ZAT_B20_AUTOSAVE =scenario_autosave(st_save_zat_b18_noah_showed_teleport)%

[sr_idle@sv_hour_fail]
on_info = {=any_actor_in_zone(zat_b20_sr_actor_cross_the_teleport)} sr_idle@sv_wait_to_fallen %+ZAT_B20_PLATEAU_WAY_DONE%

[sr_idle@sv_hour_two]
on_info = {=any_actor_in_zone(zat_b20_sr_actor_cross_the_teleport)} sr_idle@sv_wait_to_fallen %+ZAT_B20_CROSS_TELEPORT%

[sr_idle@sv_play_snd]
on_game_timer = 30 | {-ZAT_B18_NOAH_DEAD -ZAT_B20_NOAH_PLAY_SOUND} sr_idle@sv_wait_to_fallen %+ZAT_B20_NOAH_PLAY_SOUND%, sr_idle@sv_wait_to_fallen

[sr_idle@sv_wait_to_fallen]
on_info = {!any_actor_in_zone(zat_b20_actor_fallen_from_a_plateau)} sr_idle@sv_wait_to_jump %-ZAT_B20_CROSS_TELEPORT%
on_info2 = {+ZAT_B28_HELI_3_SEARCHED} sr_idle@nil

[sr_idle@sv_wait_to_jump]
on_game_timer = 20 | %=give_task(zat_b20_cross_teleport)% sr_idle@sv_hour_two

;client logic
[sr_idle@cl_start]
on_info = {+ZAT_B20_PLATEAU_WAY_STARTED} sr_idle@cl_play

[sr_idle@cl_play]
on_info = {+ZAT_B20_PLATEAU_WAY_GO =is_local_actor_relevant(10:zat_b18_noah)} sr_idle@cl_timer, {+ZAT_B20_PLATEAU_WAY_GO !is_local_actor_relevant(10:zat_b18_noah)} sr_idle@cl_wait
on_info2 = {+ZAT_B20_PLATEAU_WAY_DONE} sr_idle@nil

[sr_idle@cl_timer]
on_info = {+ZAT_B20_PLATEAU_WAY_CUT_WAIT1} sr_idle@cl_create %=run_postprocess(fade_in)% 
on_info2 = {+ZAT_B18_NOAH_DEAD} sr_idle@nil  %=enable_ui%

[sr_idle@cl_create]
on_info = {+ZAT_B20_PLATEAU_WAY_CUT_WAIT2} sr_idle@cl_enable_ui %=run_postprocess(black:22219:true)%
on_info2 = {+ZAT_B18_NOAH_DEAD} sr_idle@nil  %=enable_ui =stop_postprocess(22219)%

[sr_idle@cl_enable_ui]
on_info = {+ZAT_B20_STOP_POSTPROCESS} sr_idle@cl_info_timer 
on_info2 = {+ZAT_B18_NOAH_DEAD} sr_idle@nil  %=enable_ui =stop_postprocess(22219)%

[sr_idle@cl_info_timer]
on_info = {+ZAT_B20_PLATEAU_WAY_CUT_START} sr_cutscene@cl_cam %=stop_postprocess(22219)%
on_info2 = {+ZAT_B18_NOAH_DEAD} sr_idle@nil  %=enable_ui =stop_postprocess(22219)%
               									
[sr_cutscene@cl_cam]
point = zat_b20_smart_terrain_actor_spawn_walk
look = zat_b20_smart_terrain_actor_spawn_look
cam_effector = scenario_cam\Zaton\zat_b20_teleport_dive
on_signal = cameff_end | sr_idle@cl_wait %+ZAT_B20_PLATEAU_WAY_KNOWN%
on_signal2 = cam_effector_stop | sr_idle@cl_wait %+ZAT_B20_PLATEAU_WAY_KNOWN%
global_cameffect = true
outdoor = true
;on_info = {+ZAT_B18_NOAH_DEAD} %=stop_sr_cutscene +ZAT_B20_PLATEAU_WAY_KNOWN%               		
on_info = {+ZAT_B20_ACTOR_HIT} %=stop_sr_cutscene%
on_game_timer = 20 | {-ZAT_B20_NOAH_READY_TO_JUMP}  %+ZAT_B20_NOAH_READY_TO_JUMP%  
enable_ui_on_end = true 

[sr_idle@cl_wait]
on_info = {=any_actor_in_zone(zat_b20_sr_actor_cross_the_teleport) =is_local_actor_relevant_zone(25:zat_b20_sr_actor_cross_the_teleport) +ZAT_B20_PLATEAU_WAY_DONE +ZAT_B20_NOAH_PLAY_SOUND} sr_idle@nil %=play_sound(zat_b20_noah_jumped)%, {=any_actor_in_zone(zat_b20_sr_actor_cross_the_teleport) !is_local_actor_relevant_zone(25:zat_b20_sr_actor_cross_the_teleport) +ZAT_B20_PLATEAU_WAY_DONE +ZAT_B20_NOAH_PLAY_SOUND} sr_idle@nil

[sr_idle@nil]

