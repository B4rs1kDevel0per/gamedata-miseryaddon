[logic]
active = sr_idle@wait
type = sv_only

[sr_idle@wait]
on_info = {=any_actor_in_zone(zat_b104_sr_attack) =any_actor_has_item(toolkit_1)} sr_idle@with_toolkit
on_info2 = {=any_actor_in_zone(zat_b104_sr_attack) !any_actor_has_item(toolkit_1)} sr_idle@get_toolkit

[sr_idle@get_toolkit]
on_info = {!any_actor_in_zone(zat_b104_sr_attack)} sr_idle@wait
on_info2 = {=any_actor_has_item(toolkit_1)} sr_idle@got_toolkit

[sr_idle@got_toolkit]
on_info = {!any_actor_in_zone(zat_b104_sr_attack)} sr_idle@nil %+ZAT_B104_TASK_END%

[sr_idle@with_toolkit]
on_info = {!any_actor_in_zone(zat_b104_sr_attack)} sr_idle@wait
on_info2 = {=actor_has_item_count(toolkit_1:2)} sr_idle@got_toolkit

[sr_idle@nil]
