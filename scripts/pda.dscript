function get_stat(index) -- index= int        return string
	if(index==0) then
		return "00:00:00"
	elseif(index==1) then
		return tostring(xr_statistic.getLocalActorStatistic().surges)
	elseif(index==2) then
		return tostring(xr_statistic.getLocalActorStatistic().completed_quests)
	elseif(index==3) then
		return tostring(xr_statistic.getLocalActorStatistic().killed_monsters)
	elseif(index==4) then
		return tostring(xr_statistic.getLocalActorStatistic().killed_stalkers)
	elseif(index==5) then
		return tostring(xr_statistic.getLocalActorStatistic().artefacts_founded)
	elseif(index==6) then
		return tostring(xr_statistic.getLocalActorStatistic().founded_secrets)
	elseif(index==7) then
		return tostring(xr_statistic.getLocalActorStatistic().rps_games_won)
	end
end