-- ============================================================
--  Fake CAtmosFear (used if called from menu before game load)
-- ============================================================
class "CAtmosFearFake" (CUIWindow)
function CAtmosFearFake:__init() super() end
function CAtmosFearFake:loadDefaultParameters()
    -- mirrors CAtmosFear:loadDefaultParameters using param_ini
    local param_ini = ini_file("atmosfear_parameters.ltx")
    local p = xr_s.parse_ini_section_to_array(param_ini, "atmosfear_default_parameters")
    for k, v in pairs(p) do
        self["opt_"..k:gsub("opt_", "")] = v
    end
end
