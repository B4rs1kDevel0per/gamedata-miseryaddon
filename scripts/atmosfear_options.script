--------------------------------------------------------------------------------
-- AtmosFear options dialog ----------------------------------------------------
-- Made by Cromm Cruac ---------------------------------------------------------
-- for AtmosFear 3 -------------------------------------------------------------
-- 25.06.2011 ------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Ported to xrMPE by addon.
--
-- XRMPE NOTES:
--   * main_menu_on_init(menu) is declared here but NOT called automatically
--     by xrMPE's ui_main_menu.script.  Two options:
--
--     OPTION A (recommended): patch ui_main_menu.script - add a call to
--       atmosfear_options.main_menu_on_init(self) somewhere in
--       main_menu:__init(), e.g. right after self:InitCallBacks().
--
--     OPTION B: open the dialog via a keybind in bind_stalker.script
--       using xr_input or any keybind helper.
--
--   * "psi_storm_manager" does not exist in xrMPE; that functionality is
--     handled by surge_manager.  The psi_storm section in the options dialog
--     is kept for data compatibility (save/load), but calls are routed to
--     surge_manager where appropriate.
--
--   * "fallout_manager" does not exist in xrMPE either; the fallout settings
--     in the options dialog are preserved as data only.
--------------------------------------------------------------------------------

-- ============================================================
--  Entry point: call this from ui_main_menu:__init()
--  after self:InitCallBacks()
-- ============================================================
function main_menu_on_init(menu)
    -- Only add the button if btn_af_options exists in the XML layout.
    -- Add <button id="btn_af_options"> to ui_mm_main.xml to enable it.
    local function OnButton_af_options_clicked()
        if not menu.af_opt_dlg then
            menu.af_opt_dlg = atmosfear_options.af_options_dialog()
            menu.af_opt_dlg.owner = menu
        end
        menu.af_opt_dlg:SetCurrentValues()
        menu.af_opt_dlg:ShowDialog(true)
        menu:HideDialog()
        menu:Show(false)
    end
    -- pcall so the game does not crash if the button is absent from XML
    pcall(function()
        menu:AddCallback("btn_af_options", ui_events.BUTTON_CLICKED, OnButton_af_options_clicked, menu)
    end)
end

-- ============================================================
--  Dialog class
-- ============================================================
local aspectRatio = 1

class "af_options_dialog" (CUIScriptWnd)

function af_options_dialog:__init() super()
    if device().width / device().height > (1024 / 768 + 0.01) then
        aspectRatio = 0.8
    end
    self.atmosfear  = atmosfear.get_atmosfear()
    self.param_ini  = ini_file("atmosfear_parameters.ltx")
    self.m_preconditions = {}
    self:InitControls()
    self:InitCallBacks()
end

function af_options_dialog:__finalize()
end

function af_options_dialog:InitControls()
    self:SetWndRect           (Frect():set(0, 0, 1024, 768))
    self:Enable               (true)

    local xml = CScriptXmlInit()
    xml:ParseFile             ("ui_mm_atmosfear_options.xml")
    xml:InitStatic            ("background",        self)

    self.message_box          = CUIMessageBoxEx()
    xml:InitMessageBox        ("message_box",       self)
    self:Register             (self.message_box,    "msg_box")

    self.message_box_save     = CUIMessageBoxEx()
    xml:InitMessageBox        ("message_box_save",  self)
    self:Register             (self.message_box_save, "msg_box_save")

    local btn
    btn = xml:Init3tButton    ("btn_accept",        self);  self:Register(btn, "btn_accept")
    btn = xml:Init3tButton    ("btn_cancel",        self);  self:Register(btn, "btn_cancel")
    btn = xml:Init3tButton    ("btn_event_opt",     self);  self:Register(btn, "btn_event_opt")
    btn = xml:Init3tButton    ("btn_weather_opt",   self);  self:Register(btn, "btn_weather_opt")
    btn = xml:Init3tButton    ("btn_moon_opt",      self);  self:Register(btn, "btn_moon_opt")
    btn = xml:Init3tButton    ("btn_default_opt",   self);  self:Register(btn, "btn_default_opt")
    btn = xml:Init3tButton    ("btn_load_col_bal",  self);  self:Register(btn, "btn_load_col_bal")
    btn = xml:Init3tButton    ("btn_load_def_set",  self);  self:Register(btn, "btn_load_def_set")

    self.dlg_weather  = af_opt_weather()
    self.dlg_weather:InitControls(0, 0, xml, self)
    self.dlg_weather:Show(false)
    self:AttachChild(self.dlg_weather)
    self.dlg_weather:SetAutoDelete(true)

    self.dlg_event    = af_opt_event()
    self.dlg_event:InitControls(0, 0, xml, self)
    self.dlg_event:Show(false)
    self:AttachChild(self.dlg_event)
    self.dlg_event:SetAutoDelete(true)

    self.dlg_moon     = af_opt_moon()
    self.dlg_moon:InitControls(0, 0, xml, self)
    self.dlg_moon:Show(false)
    self:AttachChild(self.dlg_moon)
    self.dlg_moon:SetAutoDelete(true)

    self.dlg_default  = af_opt_default()
    self.dlg_default:InitControls(0, 0, xml, self)
    self.dlg_default:Show(false)
    self:AttachChild(self.dlg_default)
    self.dlg_default:SetAutoDelete(true)

    self:RegisterCheck      (xml, self.dlg_event,   "enable_blowout",   self)
    self:RegisterCombo      (xml, self.dlg_event,   "blowout_freq",   "blowout_freq",   self)
    self:RegisterCombo      (xml, self.dlg_event,   "blowout_fate",   "blowout_fate",   self)
    self:RegisterCombo      (xml, self.dlg_event,   "blowout_warning","blowout_warning", self)
    self:RegisterCombo      (xml, self.dlg_event,   "blowout_task",   "blowout_task",   self)
    self:RegisterCheck      (xml, self.dlg_event,   "enable_fallout",   self)
    self:RegisterCombo      (xml, self.dlg_event,   "fallout_freq",   "fallout_freq",   self)
    self:RegisterCombo      (xml, self.dlg_event,   "fallout_fate",   "fallout_fate",   self)
    self:RegisterCombo      (xml, self.dlg_event,   "fallout_warning","fallout_warning", self)
    self:RegisterCombo      (xml, self.dlg_event,   "fallout_task",   "fallout_task",   self)
    self:RegisterCheck      (xml, self.dlg_event,   "enable_psi_storm", self)
    self:RegisterCombo      (xml, self.dlg_event,   "psi_storm_freq", "psi_storm_freq", self)
    self:RegisterCombo      (xml, self.dlg_event,   "psi_storm_fate", "psi_storm_fate", self)
    self:RegisterCombo      (xml, self.dlg_event,   "psi_storm_warning","psi_storm_warning", self)
    self:RegisterCombo      (xml, self.dlg_event,   "psi_storm_task", "psi_storm_task", self)

    self:RegisterCombo      (xml, self.dlg_weather, "zaton_period_good",   "zaton_period_good",   self)
    self:RegisterCombo      (xml, self.dlg_weather, "zaton_period_bad",    "zaton_period_bad",    self)
    self:RegisterCombo      (xml, self.dlg_weather, "jupiter_period_good", "jupiter_period_good", self)
    self:RegisterCombo      (xml, self.dlg_weather, "jupiter_period_bad",  "jupiter_period_bad",  self)
    self:RegisterCombo      (xml, self.dlg_weather, "pripyat_period_good", "pripyat_period_good", self)
    self:RegisterCombo      (xml, self.dlg_weather, "pripyat_period_bad",  "pripyat_period_bad",  self)
    self:RegisterLengthRadio(xml, "zaton_period_good_length",   self.dlg_weather, self, 0, 0)
    self:RegisterLengthRadio(xml, "zaton_period_bad_length",    self.dlg_weather, self, 0, 0)
    self:RegisterLengthRadio(xml, "jupiter_period_good_length", self.dlg_weather, self, 0, 0)
    self:RegisterLengthRadio(xml, "jupiter_period_bad_length",  self.dlg_weather, self, 0, 0)
    self:RegisterLengthRadio(xml, "pripyat_period_good_length", self.dlg_weather, self, 0, 0)
    self:RegisterLengthRadio(xml, "pripyat_period_bad_length",  self.dlg_weather, self, 0, 0)
    self:RegisterCombo      (xml, self.dlg_weather, "weather_balance_presets", "weather_balance_presets", self)
    self:RegisterCombo      (xml, self.dlg_weather, "weather_length_presets",  "weather_length_presets",  self)

    self:RegisterCombo      (xml, self.dlg_moon,    "night_brightness", "night_brightness", self)
    self:RegisterLengthRadio(xml, "moon_phase", self.dlg_moon, self, 0, 0)
end

-- ============================================================
--  Helper: fill combo from ini section
-- ============================================================
function af_options_dialog:OptionsFromIni(combo, section)
    local line_count = self.param_ini:line_count(section)
    for it = 0, line_count - 1 do
        local result, id, value = self.param_ini:r_line(section, it, "", "")
        combo:AddItem(value, id)
    end
end

function af_options_dialog:RegisterCheck(xml, dialog, name, dialogObj)
    local chk = xml:InitCheck("chk_"..name, dialog)
    dialogObj:Register(chk, "chk_"..name)
end

function af_options_dialog:RegisterCombo(xml, dialog, name, ini_section, dialogObj)
    local combo = xml:InitComboBox("combo_"..name, dialog)
    dialogObj:Register(combo, "combo_"..name)
    self:OptionsFromIni(combo, ini_section)
end

function af_options_dialog:RegisterTrack(xml, dialog, name, dialogObj)
    local track = xml:InitTrackBar("track_"..name, dialog)
    dialogObj:Register(track, "track_"..name)
end

function af_options_dialog:RegisterLengthRadio(xml, name, dialog, dialogObj, x, y)
    for i = 1, 4 do
        local rb = xml:InitRadioButton("rb_"..name.."_"..i, dialog)
        dialogObj:Register(rb, "rb_"..name.."_"..i)
    end
end

-- ============================================================
--  Get/Set helpers
-- ============================================================
function af_options_dialog:SetComboValue(option_name, af_option)
    local combo = self:GetCtrl("combo_"..option_name)
    if combo and af_option then
        combo:SetCurrentID(af_option)
    end
end

function af_options_dialog:SetRadioValue(radio_name, af_option)
    for i = 1, 8 do
        local rb = self:GetCtrl("rb_"..radio_name.."_"..i)
        if rb then
            rb:SetCheck(tostring(i) == tostring(af_option))
        end
    end
end

function af_options_dialog:SetLengthRadioValue(radio_name, af_option)
    for i = 1, 4 do
        local rb = self:GetCtrl("rb_"..radio_name.."_"..i)
        if rb then
            rb:SetCheck(tostring(i*3) == tostring(af_option) or tostring(i*3-1) == tostring(af_option))
        end
    end
end

function af_options_dialog:SetCheckValue(name, af_option)
    local chk = self:GetCtrl("chk_"..name)
    if chk then
        chk:SetCheck(af_option == 1)
    end
end

function af_options_dialog:GetComboValue(option_name)
    local combo = self:GetCtrl("combo_"..option_name)
    if combo then return combo:CurrentID() end
    return nil
end

function af_options_dialog:GetRadioValue(option_name)
    for i = 1, 8 do
        local rb = self:GetCtrl("rb_"..option_name.."_"..i)
        if rb and rb:GetCheck() then
            return tostring(i)
        end
    end
    return "1"
end

function af_options_dialog:GetCheckValue(option_name)
    local chk = self:GetCtrl("chk_"..option_name)
    if chk and chk:GetCheck() then return 1 end
    return 0
end

function af_options_dialog:SetComboOption(option_name, use_get)
    local value
    if use_get then
        value = self:GetComboValue(option_name)
    else
        value = self:GetComboValue(option_name)
    end
    if value ~= nil then
        self.atmosfear["opt_"..option_name] = value
    end
end

function af_options_dialog:SetRadioOption(option_name, use_get)
    local value = self:GetRadioValue(option_name)
    self.atmosfear["opt_"..option_name] = value
end

function af_options_dialog:SetCheckOption(option_name, use_get)
    self.atmosfear["opt_"..option_name] = self:GetCheckValue(option_name)
end

-- ============================================================
--  SetCurrentValues  (populate UI from atmosfear object)
-- ============================================================
function af_options_dialog:SetCurrentValues()
    self.atmosfear = atmosfear.get_atmosfear()
    local af = self.atmosfear

    self:SetComboValue("zaton_period_good",          af.opt_zaton_period_good)
    self:SetComboValue("zaton_period_bad",           af.opt_zaton_period_bad)
    self:SetLengthRadioValue("zaton_period_good_length", af.opt_zaton_period_good_length)
    self:SetLengthRadioValue("zaton_period_bad_length",  af.opt_zaton_period_bad_length)
    self:SetComboValue("jupiter_period_good",        af.opt_jupiter_period_good)
    self:SetComboValue("jupiter_period_bad",         af.opt_jupiter_period_bad)
    self:SetLengthRadioValue("jupiter_period_good_length", af.opt_jupiter_period_good_length)
    self:SetLengthRadioValue("jupiter_period_bad_length",  af.opt_jupiter_period_bad_length)
    self:SetComboValue("pripyat_period_good",        af.opt_pripyat_period_good)
    self:SetComboValue("pripyat_period_bad",         af.opt_pripyat_period_bad)
    self:SetLengthRadioValue("pripyat_period_good_length", af.opt_pripyat_period_good_length)
    self:SetLengthRadioValue("pripyat_period_bad_length",  af.opt_pripyat_period_bad_length)

    self:SetCheckValue("enable_blowout",   af.opt_enable_blowout)
    self:SetComboValue("blowout_freq",     af.opt_blowout_freq)
    self:SetComboValue("blowout_fate",     af.opt_blowout_fate)
    self:SetComboValue("blowout_warning",  af.opt_blowout_warning)
    self:SetComboValue("blowout_task",     af.opt_blowout_task)
    self:SetCheckValue("enable_fallout",   af.opt_enable_fallout)
    self:SetComboValue("fallout_freq",     af.opt_fallout_freq)
    self:SetComboValue("fallout_fate",     af.opt_fallout_fate)
    self:SetComboValue("fallout_warning",  af.opt_fallout_warning)
    self:SetComboValue("fallout_task",     af.opt_fallout_task)
    self:SetCheckValue("enable_psi_storm", af.opt_enable_psi_storm)
    self:SetComboValue("psi_storm_freq",   af.opt_psi_storm_freq)
    self:SetComboValue("psi_storm_fate",   af.opt_psi_storm_fate)
    self:SetComboValue("psi_storm_warning",af.opt_psi_storm_warning)
    self:SetComboValue("psi_storm_task",   af.opt_psi_storm_task)

    self:SetRadioValue("moon_phase",       af.opt_moon_phase)
    self:SetComboValue("night_brightness", af.opt_night_brightness)
    self:SetComboValue("weather_balance_presets", af.opt_weather_balance_presets)
    self:SetComboValue("weather_length_presets",  af.opt_weather_length_presets)
end

-- ============================================================
--  SetDefaultValues  (reset UI to ltx defaults)
-- ============================================================
function af_options_dialog:SetDefaultValues()
    local p = xr_s.parse_ini_section_to_array(self.param_ini, "atmosfear_default_parameters")

    self:SetComboValue("zaton_period_good",          p["opt_zaton_period_good"])
    self:SetComboValue("zaton_period_bad",           p["opt_zaton_period_bad"])
    self:SetLengthRadioValue("zaton_period_good_length", tonumber(p["opt_zaton_period_good_length"]))
    self:SetLengthRadioValue("zaton_period_bad_length",  tonumber(p["opt_zaton_period_bad_length"]))
    self:SetComboValue("jupiter_period_good",        p["opt_jupiter_period_good"])
    self:SetComboValue("jupiter_period_bad",         p["opt_jupiter_period_bad"])
    self:SetLengthRadioValue("jupiter_period_good_length", tonumber(p["opt_jupiter_period_good_length"]))
    self:SetLengthRadioValue("jupiter_period_bad_length",  tonumber(p["opt_jupiter_period_bad_length"]))
    self:SetComboValue("pripyat_period_good",        p["opt_pripyat_period_good"])
    self:SetComboValue("pripyat_period_bad",         p["opt_pripyat_period_bad"])
    self:SetLengthRadioValue("pripyat_period_good_length", tonumber(p["opt_pripyat_period_good_length"]))
    self:SetLengthRadioValue("pripyat_period_bad_length",  tonumber(p["opt_pripyat_period_bad_length"]))

    self:SetCheckValue("enable_blowout",   tonumber(p["opt_enable_blowout"]))
    self:SetComboValue("blowout_freq",     p["opt_blowout_freq"])
    self:SetComboValue("blowout_fate",     p["opt_blowout_fate"])
    self:SetComboValue("blowout_warning",  p["opt_blowout_warning"])
    self:SetComboValue("blowout_task",     p["opt_blowout_task"])
    self:SetCheckValue("enable_fallout",   tonumber(p["opt_enable_fallout"]))
    self:SetComboValue("fallout_freq",     p["opt_fallout_freq"])
    self:SetComboValue("fallout_fate",     p["opt_fallout_fate"])
    self:SetComboValue("fallout_warning",  p["opt_fallout_warning"])
    self:SetComboValue("fallout_task",     p["opt_fallout_task"])
    self:SetCheckValue("enable_psi_storm", tonumber(p["opt_enable_psi_storm"]))
    self:SetComboValue("psi_storm_freq",   p["opt_psi_storm_freq"])
    self:SetComboValue("psi_storm_fate",   p["opt_psi_storm_fate"])
    self:SetComboValue("psi_storm_warning",p["opt_psi_storm_warning"])
    self:SetComboValue("psi_storm_task",   p["opt_psi_storm_task"])

    self:SetRadioValue("moon_phase",       p["opt_moon_phase"])
    self:SetComboValue("night_brightness", p["opt_night_brightness"])
    self:SetComboValue("weather_balance_presets", p["opt_weather_balance_presets"])
    self:SetComboValue("weather_length_presets",  p["opt_weather_length_presets"])
end

-- ============================================================
--  Callbacks
-- ============================================================
function af_options_dialog:InitCallBacks()
    self:AddCallback("btn_accept",       ui_events.BUTTON_CLICKED, self.OnBtnAccept,          self)
    self:AddCallback("btn_cancel",       ui_events.BUTTON_CLICKED, self.OnBtnCancel,          self)
    self:AddCallback("btn_weather_opt",  ui_events.BUTTON_CLICKED, self.OnBtnWeatherOptions,  self)
    self:AddCallback("btn_event_opt",    ui_events.BUTTON_CLICKED, self.OnBtnEventOptions,    self)
    self:AddCallback("btn_moon_opt",     ui_events.BUTTON_CLICKED, self.OnBtnMoonOptions,     self)
    self:AddCallback("btn_default_opt",  ui_events.BUTTON_CLICKED, self.OnBtnDefaultOptions,  self)
    self:AddCallback("btn_load_col_bal", ui_events.BUTTON_CLICKED, self.OnBtnLoadColorBalance,self)
    self:AddCallback("btn_load_def_set", ui_events.BUTTON_CLICKED, self.OnBtnLoadDefaultSettings, self)
    self:AddCallback("msg_box",          ui_events.MESSAGE_BOX_YES_CLICKED, self.OnMsgUserYes, self)
    self:AddCallback("msg_box_save",     ui_events.MESSAGE_BOX_OK_CLICKED,  self.OnMsgSaveOk,  self)
    self:AddCallback("combo_weather_balance_presets", ui_events.LIST_ITEM_SELECT, self.OnWeatherBalancePresets, self)
    self:AddCallback("combo_weather_length_presets",  ui_events.LIST_ITEM_SELECT, self.OnWeatherLengthPresets,  self)
end

function af_options_dialog:OnBtnWeatherOptions()
    self.dlg_weather:Show(true)
    self.dlg_event:Show(false)
    self.dlg_moon:Show(false)
    self.dlg_default:Show(false)
end

function af_options_dialog:OnBtnEventOptions()
    self.dlg_weather:Show(false)
    self.dlg_event:Show(true)
    self.dlg_moon:Show(false)
    self.dlg_default:Show(false)
end

function af_options_dialog:OnBtnMoonOptions()
    self.dlg_weather:Show(false)
    self.dlg_event:Show(false)
    self.dlg_moon:Show(true)
    self.dlg_default:Show(false)
end

function af_options_dialog:OnBtnDefaultOptions()
    self.dlg_weather:Show(false)
    self.dlg_event:Show(false)
    self.dlg_moon:Show(false)
    self.dlg_default:Show(true)
end

function af_options_dialog:OnBtnLoadColorBalance()
    -- no-op in xrMPE (postprocess done via console vars)
end

function af_options_dialog:OnBtnLoadDefaultSettings()
    self.message_box:InitMessageBox("message_box_yes_no")
    self.message_box:ShowDialog(true)
end

function af_options_dialog:OnMsgUserYes()
    self:SetDefaultValues()
end

function af_options_dialog:OnMsgSaveOk()
    -- dismiss
end

function af_options_dialog:OnWeatherBalancePresets()
    self:SetBalancePresetToCustom()
end

function af_options_dialog:OnWeatherLengthPresets()
    self:SetLengthPresetToCustom()
end

function af_options_dialog:SetBalancePresetToCustom()
    self:SetComboValue("weather_balance_presets", "custom")
end

function af_options_dialog:SetLengthPresetToCustom()
    self:SetComboValue("weather_length_presets", "custom")
end

-- --------------------------------------------------------
--  Accept: write UI values back into the CAtmosFear object
-- --------------------------------------------------------
function af_options_dialog:OnBtnAccept()
    local wm = level_weathers.get_weather_manager()
    local af = self.atmosfear

    -- Weather period settings
    self:SetComboOption("zaton_period_good",   false)
    self:SetComboOption("zaton_period_bad",    false)
    self:SetComboOption("jupiter_period_good", false)
    self:SetComboOption("jupiter_period_bad",  false)
    self:SetComboOption("pripyat_period_good", false)
    self:SetComboOption("pripyat_period_bad",  false)

    -- Period lengths - recalculate next change hour if changed
    local function period_length_changed(lvl, pd)
        local old = af["opt_"..lvl.."_period_"..pd.."_length"]
        local new = tonumber(self:GetRadioValue(lvl.."_period_"..pd.."_length"))
        if old ~= new then
            af["opt_"..lvl.."_period_"..pd.."_length"] = new
            if wm then wm:get_next_period_change_hour(wm.period) end
        end
    end
    period_length_changed("zaton",   "good")
    period_length_changed("zaton",   "bad")
    period_length_changed("jupiter", "good")
    period_length_changed("jupiter", "bad")
    period_length_changed("pripyat", "good")
    period_length_changed("pripyat", "bad")

    -- Blowout - tell surge_manager to recalculate timing if enabled/freq changed
    local blowout_changed = (af.opt_enable_blowout == 0 and self:GetCheckValue("enable_blowout") == 1)
                         or (af.opt_blowout_freq ~= tonumber(self:GetComboValue("blowout_freq")))
    self:SetComboOption("blowout_freq", true)
    if blowout_changed and surge_manager then
        local sm = surge_manager.get_surge_manager()
        if sm then sm:new_surge_time(true) end
    end

    -- Fallout (data-only in xrMPE - no fallout_manager)
    self:SetComboOption("fallout_freq", true)

    -- Psi-storm: routed to surge_manager in xrMPE
    -- (surge_manager handles both blowout and psi-storm scheduling)
    local psi_changed = (af.opt_enable_psi_storm == 0 and self:GetCheckValue("enable_psi_storm") == 1)
                     or (af.opt_psi_storm_freq ~= tonumber(self:GetComboValue("psi_storm_freq")))
    self:SetComboOption("psi_storm_freq", true)
    -- Note: no separate psi_storm_manager in xrMPE; surge_manager covers surges.
    -- If you add a dedicated psi_storm system later, call it here.

    -- Enable flags
    self:SetCheckOption("enable_blowout",   true)
    self:SetCheckOption("enable_fallout",   true)
    self:SetCheckOption("enable_psi_storm", true)

    -- Fate / warning / task strings
    self:SetComboOption("blowout_fate",      false)
    self:SetComboOption("blowout_warning",   false)
    self:SetComboOption("blowout_task",      false)
    self:SetComboOption("fallout_fate",      false)
    self:SetComboOption("fallout_warning",   false)
    self:SetComboOption("fallout_task",      false)
    self:SetComboOption("psi_storm_fate",    false)
    self:SetComboOption("psi_storm_warning", false)
    self:SetComboOption("psi_storm_task",    false)

    -- Moon phase / night brightness - refresh weather immediately
    local moon_changed = (af.opt_moon_phase ~= self:GetRadioValue("moon_phase"))
    self:SetRadioOption("moon_phase", false)
    local bright_changed = (af.opt_night_brightness ~= self:GetComboValue("night_brightness"))
    self:SetComboOption("night_brightness", false)
    if (moon_changed or bright_changed) and wm then
        wm:select_weather(true)
    end

    self:SetComboOption("weather_balance_presets", false)
    self:SetComboOption("weather_length_presets",  false)

    -- Close dialog
    self.dlg_weather:Show(false)
    self.dlg_event:Show(false)
    self.dlg_moon:Show(false)
    self.dlg_default:Show(false)
    self.owner:ShowDialog(true)
    self:HideDialog()
    self.owner:Show(true)

    self.message_box_save:InitMessageBox("message_box_ok")
    self.message_box_save:SetText("st_msg_after_save")
    self.message_box_save:ShowDialog(true)
end

function af_options_dialog:OnBtnCancel()
    self.dlg_weather:Show(false)
    self.dlg_event:Show(false)
    self.dlg_moon:Show(false)
    self.dlg_default:Show(false)
    self.owner:ShowDialog(true)
    self:HideDialog()
    self.owner:Show(true)
end

function af_options_dialog:OnKeyboard(dik, keyboard_action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if res == false then
        if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
            if dik == DIK_keys.DIK_ESCAPE then
                self:OnBtnCancel()
            end
        end
    end
    return res
end

function af_options_dialog:Update()
    CUIScriptWnd.Update(self)
end

-- ============================================================
--  Sub-panel classes (event / weather / moon / default)
--  Same layout as Misery originals; kept as thin wrappers.
-- ============================================================
class "af_opt_event" (CUIWindow)
function af_opt_event:__init() super() end
function af_opt_event:__finalize() end
function af_opt_event:InitControls(x, y, xml, handler)
    self:SetAutoDelete(true)
    xml:InitWindow("opt_event_wnd", 0, self)
end

