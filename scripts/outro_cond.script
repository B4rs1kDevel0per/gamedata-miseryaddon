-- Preconditions for Outro of STALKER: Call Of Pripyat (see game_tutorials->outro_game)

-- 4a
function skadovsk_bad_cond()
	return story_flags.has_flag("KINGPIN_GAINED")
end
-- 4b
function skadovsk_good_cond()
	return story_flags.has_flag("ONE_OF_THE_LADS_GAINED")
end
-- 4c
function skadovsk_neutral_cond()
	return ( not story_flags.has_flag("KINGPIN_GAINED") ) and ( not story_flags.has_flag("ONE_OF_THE_LADS_GAINED") )
end
-- 5a
function bloodsucker_live_cond()
	return not story_flags.has_flag("ZAT_B57_BLOODSUCKER_LAIR_CLEAR")
end
-- 5b
function bloodsucker_dead_cond()
	return story_flags.has_flag("ZAT_B57_BLOODSUCKER_LAIR_CLEAR")
end
