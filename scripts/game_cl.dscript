-- Invokes from different thread (not main) !!!!
function on_connect_started()
	fill_tables()
	sound_theme.load_sound()
	xr_s.init()
	
	get_console():execute("r2_dof_far 800")
    get_console():execute("r2_allow_r1_lights off")
    get_console():execute("r2_dof -0.400000,1.400000,500.000000")
    get_console():execute("r2_dof_enable on")
    get_console():execute("r2_dof_kernel 2.")
    get_console():execute("r2_dof_sky 0.")
    get_console():execute("r2_exp_donttest_shad off")
    get_console():execute("r2_gi off")
    get_console():execute("r2_ls_bloom_fast off")
    get_console():execute("r2_sun on")
    get_console():execute("r2_sun_depth_far_bias -0.00002")
    get_console():execute("r2_sun_depth_far_scale 1.")
    get_console():execute("r2_sun_depth_near_bias 0.00007")
    get_console():execute("r2_sun_depth_near_scale 1.")
    get_console():execute("r2_sun_details on")
    get_console():execute("r2_sun_far 180.")
    get_console():execute("r2_sun_focus on")
    get_console():execute("r2_sun_lumscale 1.")
    get_console():execute("r2_sun_lumscale_amb 0.1")
    get_console():execute("r2_sun_lumscale_hemi 0.6")
    get_console():execute("r2_sun_near 30.")
    get_console():execute("r2_sun_near_border 0.75")
    get_console():execute("r2_sun_ts on")
    get_console():execute("r2_sun_tsm_bias -0.01")
    get_console():execute("r2_sun_tsm_proj 0.3")
    get_console():execute("r2_tf_mipbias 0.")
    get_console():execute("r2_tonemap on")
    get_console():execute("r2_tonemap_adaptation 0.2")
    get_console():execute("r2_tonemap_amount 1.")
    get_console():execute("r2_tonemap_lowlum 0.4")
    get_console():execute("r2_tonemap_middlegray 1.1")
    get_console():execute("rs_c_brightness 1.")
    get_console():execute("rs_c_contrast 1.")
    get_console():execute("rs_c_gamma 1.")
	
	if not dialogs_filled then
		dialog_manager.fill_phrase_table()
		dialogs_filled = true
	end
	
	
	xr_statistic.actor_statistic.completed_quests = 0
end