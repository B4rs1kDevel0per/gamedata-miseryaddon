local ignored_smart = {
	zat_stalker_base_smart	= true,
	jup_b41					= true,
	jup_a6					= true,
	pri_a16					= true
}

local ignored_zone = {
	"zat_a2_sr_no_assault",
	"jup_a6_sr_no_assault",
	"jup_b41_sr_no_assault"
}

local smarts_by_no_assault_zones = {
	["zat_a2_sr_no_assault"]	= "zat_stalker_base_smart",
	["jup_a6_sr_no_assault"]	= "jup_a6",
	["jup_b41_sr_no_assault"]	= "jup_b41"
}

-- Р“Р»РѕР±Р°Р»СЊРЅС‹Рµ С‚Р°Р±Р»РёС†С‹ (С‚Р°РєР¶Рµ РѕР±СЉСЏРІР»РµРЅС‹ РІ _g.script РґР»СЏ РґРѕСЃС‚СѓРїРЅРѕСЃС‚Рё РґРѕ Р·Р°РіСЂСѓР·РєРё РјРѕРґСѓР»СЏ)
fighting_with_actor_npcs = {}
safe_zone_npcs           = {}

-- РќР°СЃС‚СЂРѕР№РєРё РёР· ltx (РёРЅРёС†РёР°Р»РёР·РёСЂСѓСЋС‚СЃСЏ РІ on_game_start, РЅРµ РЅР° СѓСЂРѕРІРЅРµ РјРѕРґСѓР»СЏ)
local CombatInertion     = {}
local CombatInertionMult = {}
local ForbiddenNPCs      = {}
TimeSafe = 120000

----------------------------------------------------------------------------------------------------------------------
-- on_game_start: РёРЅРёС†РёР°Р»РёР·Р°С†РёСЏ ltx (РІС‹Р·С‹РІР°РµС‚СЃСЏ РґРІРёР¶РєРѕРј РїРѕСЃР»Рµ Р·Р°РіСЂСѓР·РєРё РІСЃРµС… СЃРєСЂРёРїС‚РѕРІ)
----------------------------------------------------------------------------------------------------------------------
function on_game_start()
	local ini = ini_file("ai_tweaks\\xr_combat_ignore.ltx")
	if ini then
		CombatInertion     = alun_utils.collect_section(ini, "combat_inertion",      true)
		CombatInertionMult = alun_utils.collect_section(ini, "combat_inertion_mult", true)
		ForbiddenNPCs      = alun_utils.collect_section(ini, "forbidden_npcs",       true)
		TimeSafe           = alun_utils.read_from_ini(ini, "settings", "time_safe", "float", 120000)
	end
	-- РљРѕР»Р»Р±СЌРєРё: РІ xrMPE СЂРµРіРёСЃС‚СЂРёСЂСѓСЋС‚СЃСЏ С‡РµСЂРµР· ai_tweaks.npc_on_update/hit/death
	-- РїРѕСЌС‚РѕРјСѓ Р·РґРµСЃСЊ РЅРµ СЂРµРіРёСЃС‚СЂРёСЂСѓРµРј РЅР°РїСЂСЏРјСѓСЋ
end

----------------------------------------------------------------------------------------------------------------------
-- Safe zone
----------------------------------------------------------------------------------------------------------------------
function npc_in_safe_zone(npc)
	local squad = get_object_squad(npc)
	if (squad and safe_zone_npcs[squad.id]) or safe_zone_npcs[npc:id()] then
		return true
	end
end

function npc_on_update(npc, st)
	if character_community(npc) == "zombied" then return end

	if not st.safe_zone_dtimer then
		st.safe_zone_dtimer = 0
	end
	local tg = time_global()
	if tg < st.safe_zone_dtimer then return end
	st.safe_zone_dtimer = tg + 5000

	local se_obj = alife() and alife():object(npc:id())
	if not se_obj then return end

	local squad = get_object_squad(npc)
	local cid   = squad and squad.id or npc:id()

	if safe_zone_npcs[cid] then
		if tg > safe_zone_npcs[cid] + TimeSafe then
			safe_zone_npcs[cid] = nil
		end
	else
		for _, v in ipairs(ignored_zone) do
			local zone = db.zone_by_name[v]
			if zone and utils.npc_in_zone(npc, zone) then
				safe_zone_npcs[cid] = tg
			end
		end
	end
end

function npc_on_hit_callback(npc, amount, local_direction, who, bone_index)
	if amount == 0 then return end
	if not db.storage[npc:id()] then return end

	db.storage[npc:id()].hitted_by = who and who:id()

	local squad = get_object_squad(npc)
	if not squad then return end

	if safe_zone_npcs[squad.id] then
		if who and is_object_actor_by_id(who:id()) and db.storage[npc:id()].hitted_by == who:id() then
			alun_utils.set_squad_relation(npc, who, game_object.enemy)
			for k in squad:squad_members() do
				local member = db.storage[k.id] and db.storage[k.id].object
				if member then
					xr_logic.pstor_store(member, "can_attack_actor", true)
				end
				local mst = db.storage[k.id] and db.storage[k.id].combat_ignore
				if member and member:alive() and mst and mst.enabled then
					fighting_with_actor_npcs[member:id()] = true
					mst.enabled = false
				end
			end
		end
	end
end

function npc_on_death_callback(npc, who)
	safe_zone_npcs[npc:id()] = nil
end

function squad_on_npc_death(squad, npc)
	if squad:npc_count() == 0 then
		safe_zone_npcs[squad.id] = nil
	end
end

----------------------------------------------------------------------------------------------------------------------
-- is_enemy (СЃРёРіРЅР°С‚СѓСЂР° СЃРѕРІРјРµСЃС‚РёРјР° СЃРѕ РІСЃРµРјРё РІС‹Р·С‹РІР°СЋС‰РёРјРё СЃРєСЂРёРїС‚Р°РјРё: 4 Р°СЂРіСѓРјРµРЅС‚Р°)
-- is_enemy(obj, enemy, st, no_memory)
----------------------------------------------------------------------------------------------------------------------
function ignore_enemy_by_overrides(obj, enemy)
	local overrides = db.storage[obj:id()] and db.storage[obj:id()].overrides
	if overrides and overrides.combat_ignore then
		if xr_logic.pick_section_from_condlist(enemy, obj, overrides.combat_ignore.condlist) == "true" then
			return true
		end
	end
	return false
end

function is_enemy(obj, enemy, st, no_memory)
	if not obj:alive() then return false end
	if obj:critically_wounded() then return true end

	-- st РјРѕР¶РµС‚ Р±С‹С‚СЊ С‚Р°Р±Р»РёС†РµР№ РёР»Рё nil (РІС‹Р·РѕРІС‹ РёР· post_combat_idle, xr_danger)
	if type(st) ~= "table" then
		st = db.storage[obj:id()] and db.storage[obj:id()].combat_ignore
	end

	if not st then return true end
	if st.enabled == false then return true end

	local obj_id  = obj:id()
	local ene_id  = enemy:id()
	local storage = db.storage[obj_id]
	if storage == nil then return true end
	storage.enemy_id = ene_id

	-- Safe zone
	if IsStalker(obj) and character_community(obj) ~= "zombied"
		and character_community(enemy) ~= "zombied" and not IsMonster(enemy) then

		local squad = get_object_squad(obj)
		local cid   = squad and squad.id or obj_id

		if safe_zone_npcs[cid] then
			local can_attack = xr_logic.pstor_retrieve(obj, "can_attack_actor", nil)
			if is_object_actor_by_id(ene_id) and obj:relation(enemy) == game_object.enemy and can_attack == true then
				if squad then
					for k in squad:squad_members() do
						local mst = db.storage[k.id] and db.storage[k.id].combat_ignore
						if mst and mst.enabled then mst.enabled = false end
					end
				end
				return true
			else
				return false
			end
		end

		if not is_object_actor_by_id(ene_id) then
			local ene_squad = get_object_squad(enemy)
			local bid = ene_squad and ene_squad.id or ene_id
			if safe_zone_npcs[bid] then return false end
		end
	end

	-- Р’Р°РЅРёР»Р»СЊРЅС‹Рµ no_assault Р·РѕРЅС‹
	local active_sector = storage.active_sector
	if active_sector ~= nil then
		if sr_danger.check_danger_position(enemy:position(), active_sector) == false then
			return false
		end
	end

	if not is_object_actor_by_id(ene_id) then
		for k, v in pairs(smarts_by_no_assault_zones) do
			local zone = db.zone_by_name[k]
			if zone and (utils.npc_in_zone(obj, zone) or utils.npc_in_zone(enemy, zone)) then
				local smart = sim_board.get_sim_board():get_smart_by_name(v)
				if smart and smart.base_on_actor_control ~= nil
					and smart.base_on_actor_control.status ~= smart_terrain_control.ALARM then
					return false
				end
			end
		end
	end

	local se_enemy = alife():object(ene_id)
	if se_enemy ~= nil and se_enemy.m_smart_terrain_id ~= nil and se_enemy.m_smart_terrain_id ~= 65535 then
		local enemy_smart = alife():object(se_enemy.m_smart_terrain_id)
		if enemy_smart and ignored_smart[enemy_smart:name()] == true then
			return false
		end
	end

	-- Overrides
	if ignore_enemy_by_overrides(obj, enemy) then return false end

	return true
end

----------------------------------------------------------------------------------------------------------------------

class "action_process_enemy"

function action_process_enemy:__init(obj, storage)
	self.object = obj
	self.st     = storage
	self.comm   = get_object_community(obj)
	self.rank   = ranks.get_obj_rank_name(obj)
	self.st.stage           = 0
	self.st.combat_inertion = 60000  -- РґРµС„РѕР»С‚ РґР»СЏ РІСЃРµС… С‚РёРїРѕРІ

	if not IsStalker(obj) then return end
	if self.comm == "zombied" then return end

	local search      = CombatInertion[self.comm] or "60000"
	local search_time = xr_logic.pick_section_from_condlist(db.actor, obj,
		xr_logic.parse_condlist(obj, self.comm, "combat_inertion", search))
	self.st.combat_inertion = search_time and tonumber(search_time) or 60000

	local mult = CombatInertionMult[self.rank] and tonumber(CombatInertionMult[self.rank]) or 1
	self.st.combat_inertion = self.st.combat_inertion * mult
end

function action_process_enemy:trader_enemy_callback(obj, enemy)
	return false
end

function action_process_enemy:enemy_callback(npc, enemy)
	if self.st.stage == 0 then
		local is_obj_enemy = is_enemy(npc, enemy, self.st, false)
		if is_obj_enemy then
			local id     = npc:id()
			local ene_id = enemy:id()

			if is_object_actor_by_id(ene_id) then
				fighting_with_actor_npcs[id] = true
				if alun_plugin_manager then
					alun_plugin_manager.on_fighting_actor(npc)
				end
			end

			-- smart alarm
			local se_obj = alife() and alife():object(id)
			if se_obj and se_obj.m_smart_terrain_id ~= 65535 then
				local smart_obj = alife():object(se_obj.m_smart_terrain_id)
				smart_obj:set_alarm()
				if is_object_actor_by_id(ene_id) and smart_obj.base_on_actor_control ~= nil then
					smart_obj.base_on_actor_control:actor_attack()
				end
			end

			-- РІС‹Р±РѕСЂ СЃС‚Р°РґРёРё
			if ForbiddenNPCs[npc:section()] or ForbiddenNPCs[enemy:section()]
				or string.find(level.get_weather(), "veryfoggy") then
				self.st.stage = 3
			elseif string.find(level.get_weather(), "foggy")
				or self.comm == "monster" or self.comm == "zombied"
				or character_community(enemy) == "zombied"
				or character_community(enemy) == "monster" then
				self.st.stage = 2
			else
				self.st.stage = 1
			end
			return true
		end
		return false

	elseif self.st.stage == 1 then
		return true

	elseif self.st.stage == 2 then
		if npc:position():distance_to_sqr(enemy:position()) > 22500 then
			if is_object_actor_by_id(enemy:id()) then
				fighting_with_actor_npcs[npc:id()] = nil
			end
			local nst = db.storage[npc:id()]
			if nst and nst.enemy_id == enemy:id() then nst.enemy_id = nil end
			self.st.enabled = true
			self.st.stage   = 0
			return false
		end
		self.st.stage = 0
		return true

	elseif self.st.stage == 3 then
		if npc:position():distance_to_sqr(enemy:position()) > 5700 then
			if is_object_actor_by_id(enemy:id()) then
				fighting_with_actor_npcs[npc:id()] = nil
			end
			local nst = db.storage[npc:id()]
			if nst and nst.enemy_id == enemy:id() then nst.enemy_id = nil end
			self.st.enabled = true
			self.st.stage   = 0
			return false
		end
		self.st.stage = 0
		return true
	end
end

function action_process_enemy:hit_callback(obj, amount, local_direction, who, bone_index)
	if who == nil then return end
	if amount == 0 then return end
	if is_object_actor_by_id(who:id()) then
		local overrides = self.st.overrides
		if not overrides or not overrides.combat_ignore_keep_when_attacked then
			self.st.enabled = false
		end
	end
end

----------------------------------------------------------------------------------------------------------------------
-- binder
----------------------------------------------------------------------------------------------------------------------
function add_to_binder(npc, ini, scheme, section, storage)
	local new_action = this.action_process_enemy(npc, storage)
	storage.action = new_action
end

function set_combat_ignore_checker(npc, ini, scheme)
	local st = xr_logic.assign_storage_and_bind(npc, ini, scheme)
end

function reset_combat_ignore_checker(npc, scheme, st, section)
	local storage = st.combat_ignore

	if npc:character_community() == "trader"
		or npc:clsid() == clsid.script_trader
		or npc:clsid() == clsid.trader then
		npc:set_enemy_callback(storage.action.trader_enemy_callback, storage.action)
	else
		npc:set_enemy_callback(storage.action.enemy_callback, storage.action)
	end

	xr_logic.subscribe_action_for_events(npc, storage, storage.action)
	storage.overrides = xr_logic.generic_scheme_overrides(npc)
	storage.enabled   = true
end

function disable_scheme(npc, scheme)
	npc:set_enemy_callback()
	local st = db.storage[npc:id()][scheme]
	if st then
		xr_logic.unsubscribe_action_from_events(npc, st, st.action)
	end
end
