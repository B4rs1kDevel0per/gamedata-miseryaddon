-----------------------------------------------------------------------------------
-- LEVELS
-----------------------------------------------------------------------------------
function level_zaton(first_speaker, second_speaker)
	return level.name() == "zaton"
end

function level_jupiter(first_speaker, second_speaker)
	return level.name() == "jupiter"
end

function level_pripyat(first_speaker, second_speaker)
	return level.name() == "pripyat"
end

function not_level_zaton(first_speaker, second_speaker)
	return level.name() ~= "zaton"
end

function not_level_jupiter(first_speaker, second_speaker)
	return level.name() ~= "jupiter"
end

function not_level_pripyat(first_speaker, second_speaker)
	return level.name() ~= "pripyat"
end
--------------------------------------------------------------------------------
--			ALIFE SUPPORT
--------------------------------------------------------------------------------

---------------------
function quest_dialog_heli_precond(first_speaker, second_speaker)
	if (story_flags.has_flag("JUP_B9_HELI_1_SEARCHED") and
				story_flags.has_flag("ZAT_B100_HELI_2_SEARCHED") and
				story_flags.has_flag("ZAT_B28_HELI_3_SEARCHED") and
				story_flags.has_flag("JUP_B8_HELI_4_SEARCHED") and
				story_flags.has_flag("ZAT_B101_HELI_5_SEARCHED")) or
				story_flags.has_flag("PRI_B305_ACTOR_WONDERED_DONE") then
			return false
	end

	return true
end

function quest_dialog_military_precond(first_speaker, second_speaker)
	if story_flags.has_flag("ZAT_B28_HELI_3_SEARCHED") or story_flags.has_flag("JUP_B9_BLACKBOX_DECRYPTED") then
		if not (story_flags.has_flag("ZAT_B28_HELI_3_SEARCHED") and story_flags.has_flag("JUP_B9_BLACKBOX_DECRYPTED")) then
			return true
		end
	end
	return false
end

function quest_dialog_squad_precond(first_speaker, second_speaker)
	return not (story_flags.has_flag("JUP_B218_MONOLITH_HIRED") and story_flags.has_flag("JUP_B218_SOLDIER_HIRED") and story_flags.has_flag("JUP_A10_VANO_AGREE_GO_UND"))
end

function quest_dialog_toolkits_precond(first_speaker, second_speaker)
	if story_flags.has_flag("ZAT_A2_MECHANIC_TOOLKIT_SEARCH") and not story_flags.has_flag("ZAT_B3_TASK_END") then
		return true
	elseif story_flags.has_flag("JUP_B217_TECH_INSTRUMENTS_START") and not story_flags.has_flag("JUP_B217_TASK_END") then
		return true
	end
	return false
end


