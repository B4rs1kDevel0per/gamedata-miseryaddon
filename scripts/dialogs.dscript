function dolg_can_work_for_sci(first_speaker, second_speaker)
	return not (story_flags.has_flag("JUP_A6_FREEDOM_LEADER_BUNKER_GUARDS_WORK") or story_flags.has_flag("JUP_A6_FREEDOM_LEADER_BUNKER_SCAN_WORK"))
end

function dolg_can_not_work_for_sci(first_speaker, second_speaker)
	return story_flags.has_flag("JUP_A6_FREEDOM_LEADER_BUNKER_GUARDS_WORK") or story_flags.has_flag("JUP_A6_FREEDOM_LEADER_BUNKER_SCAN_WORK")
end

function freedom_can_work_for_sci(first_speaker, second_speaker)
	return not (story_flags.has_flag("JUP_A6_DUTY_LEADER_BUNKER_GUARDS_WORK") or story_flags.has_flag("JUP_A6_DUTY_LEADER_BUNKER_SCAN_WORK"))
end

function freedom_can_not_work_for_sci(first_speaker, second_speaker)
