		getLocalActor():eat(getLocalActor():object("vodka_script"))
	end
end

local mat_table = {
					"jup_b200_material_1",
					"jup_b200_material_2",
					"jup_b200_material_3",
					"jup_b200_material_4",
					"jup_b200_material_5",
					"jup_b200_material_6",
					"jup_b200_material_7",
					"jup_b200_material_8",
					"jup_b200_material_9",
					}

function jup_b200_count_found(actor)
	local cnt = 0
						
	for k,v in pairs(mat_table) do
		local material_obj = get_story_object(v)
		if material_obj then
			local parent = material_obj:parent() 
			if parent then
				local parent_id = parent:id()
				for k, v in pairs (db.mp_actors) do 
					if parent_id ~= 65535 and parent_id == v:id() then
						cnt = cnt + 1
					end
				end
			end
		end
	end
	
	cnt = cnt + xr_logic.pstor_retrieve(actor, "jup_b200_tech_materials_brought_counter", 0)
	xr_logic.pstor_store(actor, "jup_b200_tech_materials_found_counter", cnt)
end

function set_start_squad_relation(actor, npc)
	if OnServer() then
		local tbl = { "zat_b103_lost_merc_squad1", "jup_b204_squad", "jup_b4_squad", "jup_b47_merc_guard_squad" }
		
		for k,v in pairs(tbl) do
			local squad = get_story_squad(v)
			if squad ~= nil then
				squad:set_squad_relation()
			else
				printf_msg("Can't find squad %s", v)
			end
		end
	end
end

function zat_b29_get_artefact(npc)
	local af_name
	for i = 16, 23 do
		if story_flags.has_flag(dialogs_zaton.zat_b29_infop_bring_table[i]) then
			af_name = dialogs_zaton.zat_b29_af_table[i]
			break
		end
	end
	if af_name ~= nil then
		local obj = npc:object(af_name)
		if obj ~= nil then
			obj:enable_attachable_item(true)
		end
	end
end

function zat_b29_hide_artefact(npc)
	local af_name
	for i = 16, 23 do
		if story_flags.has_flag(dialogs_zaton.zat_b29_infop_bring_table[i]) then
			af_name = dialogs_zaton.zat_b29_af_table[i]
			break
		end
	end
	if af_name ~= nil then
		local obj = npc:object(af_name)
		if obj ~= nil then
			obj:enable_attachable_item(false)
		end
	end
end

