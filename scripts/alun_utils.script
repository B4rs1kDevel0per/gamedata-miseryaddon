-- fake_squad — заглушка для NPC без отряда
------------------------------------------------------

class "fake_squad"
function fake_squad:__init() end
function fake_squad:am_i_reached(squad) end
function fake_squad:on_reach_target(squad) end
function fake_squad:on_after_reach_target(squad) end

------------------------------------------------------
-- INI секции
------------------------------------------------------

function collect_sections(ini, sections)
	local r, p = {}, {}
	for k, v in ipairs(sections) do
		if ini:section_exist(v) then
			local n = ini:line_count(v)
			for i = 0, n - 1 do
				local _, id, val = ini:r_line(v, i, "", "")
				if r[id] == nil then r[id] = val end
			end
			p[k] = n
		else
			p[k] = 0
		end
	end
	return r, p
end

function collect_section(ini, section, keytable)
	local _t = {}
	if ini:section_exist(section) then
		local n = ini:line_count(section)
		for i = 0, n - 1 do
			local _, id, val = ini:r_line(section, i, "", "")
			if not keytable then
				table.insert(_t, id)
			else
				_t[id] = val or true
			end
		end
	end
	return _t
end

------------------------------------------------------
-- Командиры отрядов
------------------------------------------------------

function get_commander(npc)
	local squad = npc and get_object_squad(npc)
	if squad and squad:commander_id() then
		return level.object_by_id(squad:commander_id())
	end
end

function get_squad_commander_action(npc)
	local commander = get_commander(npc)
	local mgr = commander and commander:motivation_action_manager()
	if mgr and mgr:initialized() then
		return mgr:current_action_id()
	end
end

------------------------------------------------------
-- Хранилище AI-данных (адаптировано из Rulix/Alundaio)
-- get_storage(id, name) → таблица db.storage[id].ai_tweaks[name]
-- Позволяет хранить AI-данные не засоряя db.storage напрямую.
------------------------------------------------------

function get_storage(id, name)
	if not id then return {} end
	local st = db.storage[id]
	if not st then return {} end
	if not st.ai_tweaks then st.ai_tweaks = {} end
	if not name then return st.ai_tweaks end
	if not st.ai_tweaks[name] then st.ai_tweaks[name] = {} end
	return st.ai_tweaks[name]
end

------------------------------------------------------
-- Аддоны оружия (перенесено из Misery alun_utils)
-- get_addon_status(wpn, addon) → 0 (нет), 1 (встроен), 2 (съёмный)
-- get_addon_flag(wpn)          → битовая маска: sc=1, gl=2, sl=4
-- addon_attached(wpn, addon)   → true если аддон физически прикреплён
------------------------------------------------------

function get_addon_status(wpn, addon)
	if addon == "sc" then return wpn:weapon_scope_status()
	elseif addon == "sl" then return wpn:weapon_silencer_status()
	elseif addon == "gl" then return wpn:weapon_grenadelauncher_status()
	end
	return 0
end

-- Мемоизация: кэшируем результат на один тик чтобы не дёргать API каждый вызов
local _addon_cache = {}
function get_addon_flag(wpn, with_int)
	local id, tg = wpn:id(), time_global()
	local c = _addon_cache
	if c.tg == tg and c.id == id and c.wi == with_int then return c.fl end
	local flag = 0
	if wpn:weapon_is_scope() then
		if with_int or get_addon_status(wpn,"sc") == 2 then flag = flag + 1 end
	end
	if wpn:weapon_is_grenadelauncher() then
		if with_int or get_addon_status(wpn,"gl") == 2 then flag = flag + 2 end
	end
	if wpn:weapon_is_silencer() then
		if with_int or get_addon_status(wpn,"sl") == 2 then flag = flag + 4 end
	end
	_addon_cache = {tg=tg, id=id, wi=with_int, fl=flag}
	return flag
end

function addon_attached(wpn, addon, flag)
	-- sc=1, gl=2, sl=4; комбинации покрывают все варианты битовой маски
	local ft = {
		sc = {[1]=true, [3]=true, [5]=true, [7]=true},
		gl = {[2]=true, [3]=true, [6]=true, [7]=true},
		sl = {[4]=true, [5]=true, [6]=true, [7]=true},
	}
	if ft[addon] then
		return ft[addon][flag or get_addon_flag(wpn, true)] == true
	end
	return false
end

------------------------------------------------------
-- Типы оружия по clsid
-- weapon_types_clslist — глобальная таблица (нужна снаружи)
-- isPistol / isSniper / isShotgun / isRifle / isLauncher
------------------------------------------------------

-- Ленивая инициализация: clsid доступны только после старта движка
local _types_built = false
weapon_types_clslist = {}

local function build_weapon_types()
	if _types_built then return end
	_types_built = true
	weapon_types_clslist = {
		pistol         = {[clsid.wpn_pm_s]=true, [clsid.wpn_walther_s]=true,
		                  [clsid.wpn_usp45_s]=true, [clsid.wpn_hpsa_s]=true},
		sniper         = {[clsid.wpn_svu_s]=true, [clsid.wpn_svd_s]=true,
		                  [clsid.wpn_vintorez_s]=true},
		launcher       = {[clsid.wpn_rg6_s]=true, [clsid.wpn_rpg7_s]=true},
		shotgun        = {[clsid.wpn_shotgun_s]=true, [clsid.wpn_auto_shotgun_s]=true},
		double_barreled= {[clsid.wpn_bm16_s]=true},
		rifle          = {[clsid.wpn_ak74_s]=true, [clsid.wpn_lr300_s]=true,
		                  [clsid.wpn_groza_s]=true, [clsid.wpn_val_s]=true},
		knife          = {[clsid.wpn_knife_s]=true},
	}
end

function isPistol(wpn, c)
	build_weapon_types()
	if not c then c = wpn and wpn:clsid() end
	return weapon_types_clslist.pistol[c]
end

function isSniper(wpn, c)
	build_weapon_types()
	if not c then c = wpn and wpn:clsid() end
	return weapon_types_clslist.sniper[c]
end

function isShotgun(wpn, c)
	build_weapon_types()
	if not c then c = wpn and wpn:clsid() end
	return weapon_types_clslist.shotgun[c] or weapon_types_clslist.double_barreled[c]
end

function isRifle(wpn, c)
	build_weapon_types()
	if not c then c = wpn and wpn:clsid() end
	return weapon_types_clslist.rifle[c]
end

function isLauncher(wpn, c)
	build_weapon_types()
	if not c then c = wpn and wpn:clsid() end
	return weapon_types_clslist.launcher[c]
end

------------------------------------------------------
-- Огнестрельное оружие (любое)
-- item_is_fa(o, c) → true если предмет является стреляющим оружием
------------------------------------------------------

local _fa_clsids = nil
local function build_fa_clsids()
	_fa_clsids = {
		[clsid.wpn_pm_s]=true, [clsid.wpn_walther_s]=true,
		[clsid.wpn_usp45_s]=true, [clsid.wpn_hpsa_s]=true,
		[clsid.wpn_bm16_s]=true, [clsid.wpn_shotgun_s]=true,
		[clsid.wpn_auto_shotgun_s]=true, [clsid.wpn_ak74_s]=true,
		[clsid.wpn_lr300_s]=true, [clsid.wpn_groza_s]=true,
		[clsid.wpn_val_s]=true, [clsid.wpn_vintorez_s]=true,
		[clsid.wpn_svu_s]=true, [clsid.wpn_svd_s]=true,
		[clsid.wpn_rg6_s]=true, [clsid.wpn_rpg7_s]=true,
		[clsid.wpn_knife_s]=true,
	}
end

function item_is_fa(o, c)
	if not _fa_clsids then build_fa_clsids() end
	if not c then c = o and o:clsid() end
	return c and _fa_clsids[c] or false
end

