-----------------------------------------------------
-- alun_utils.lua (minimal for random_loadouts)
-----------------------------------------------------

local DBG = false

function read_from_ini(ini, section, line, var_type, default)
	if not ini then
		ini = system_ini()
	end
	if section and line and ini:section_exist(section) and ini:line_exist(section, line) then
		if     var_type == "bool"   then return ini:r_bool(section, line)
		elseif var_type == "string" then return ini:r_string(section, line)
		elseif var_type == "float"  then return ini:r_float(section, line)
		else                             return ini:r_string_wq(section, line)
		end
	end
	return default
end

function trim(s)
	return string.gsub(s, "^%s*(.-)%s*$", "%1")
end

function string:split(pat)
	local st, g = 1, self:gmatch("()(" .. pat .. ")")
	local function getter(self, segs, seps, sep, cap1, ...)
		st = sep and seps + #sep
		return self:sub(segs, (seps or 0) - 1), cap1 or sep, ...
	end
	local function splitter(self)
		if st then return getter(self, st, g()) end
	end
	return splitter, self
end

function str_explode(str, pattern)
	if type(str) ~= "string" then return {} end  -- возвращаем пустую таблицу вместо nil
	local t = {}
	for word, pat, start in str:split(pattern) do
		t[#t + 1] = trim(word)
		if start and pat == pattern then
			t[#t + 1] = trim(str:sub(start))
			break
		end
	end
	return t
end

function parse_list(ini, key, val, convert)
	local str = read_from_ini(ini, key, val, "string", "")
	local t = str_explode(str, ",")
	if convert and #t > 0 then
		local l = {}
		for _, v in ipairs(t) do
			l[v] = true
		end
		return l
	end
	return t
end

local ranks
function get_rank_list()
	if ranks then return ranks end
	local tmp = parse_list(nil, "game_relations", "rating")
	ranks = {}
	for _, rn in ipairs(tmp) do
		if not tonumber(rn) then
			table.insert(ranks, rn)
		end
	end
	return ranks
end

function rand_num(a, b)
	if a and b then return math.random(a, b) end
	return math.random()
end

class "fake_squad"
function fake_squad:__init() end
function fake_squad:am_i_reached(squad) end
function fake_squad:on_reach_target(squad) end
function fake_squad:on_after_reach_target(squad) end

function collect_sections(ini, sections)
	local r, p = {}, {}
	for k, v in ipairs(sections) do
		if ini:section_exist(v) then
			local n = ini:line_count(v)
			for i = 0, n - 1 do
				local _, id, val = ini:r_line(v, i, "", "")
				if r[id] == nil then r[id] = val end
			end
			p[k] = n
		else
			p[k] = 0
		end
	end
	return r, p
end

function collect_section(ini, section, keytable)
	local _t = {}
	if ini:section_exist(section) then
		local n = ini:line_count(section)
		for i = 0, n - 1 do
			local _, id, val = ini:r_line(section, i, "", "")
			if not keytable then
				table.insert(_t, id)
			else
				_t[id] = val or true
			end
		end
	end
	return _t
end

function get_commander(npc)
	local squad = npc and get_object_squad(npc)
	if squad and squad:commander_id() then
		return level.object_by_id(squad:commander_id())
	end
end

function get_squad_commander_action(npc)
	local commander = get_commander(npc)
	local mgr = commander and commander:motivation_action_manager()
	if mgr and mgr:initialized() then
		return mgr:current_action_id()
	end
end

-- Таблица clsid огнестрельного оружия — объявлена один раз на уровне модуля,
-- не пересоздаётся при каждом вызове item_is_fa
local _fa_clsids = nil
local function build_fa_clsids()
	_fa_clsids = {
		[clsid.wpn_pm_s]          = true,
		[clsid.wpn_walther_s]     = true,
		[clsid.wpn_usp45_s]       = true,
		[clsid.wpn_hpsa_s]        = true,
		[clsid.wpn_bm16_s]        = true,
		[clsid.wpn_shotgun_s]     = true,
		[clsid.wpn_auto_shotgun_s]= true,
		[clsid.wpn_ak74_s]        = true,
		[clsid.wpn_lr300_s]       = true,
		[clsid.wpn_groza_s]       = true,
		[clsid.wpn_val_s]         = true,
		[clsid.wpn_vintorez_s]    = true,
		[clsid.wpn_svu_s]         = true,
		[clsid.wpn_svd_s]         = true,
		[clsid.wpn_rg6_s]         = true,
		[clsid.wpn_rpg7_s]        = true,
		[clsid.wpn_knife_s]       = true,
	}
end

function item_is_fa(o, c)
	-- Ленивая инициализация: clsid доступны только после старта движка
	if not _fa_clsids then build_fa_clsids() end
	if not c then c = o and o:clsid() end
	return c and _fa_clsids[c] or false
end
