-----------------------------------------------------
-- alun_utils.script
-- Утилиты для AI и случайного снаряжения NPC.
-- Адаптировано для xrMPE из Misery 2.x (Alundaio)
-----------------------------------------------------

------------------------------------------------------
-- INI / строки
------------------------------------------------------

function read_from_ini(ini, section, line, var_type, default)
	if not ini then ini = system_ini() end
	if section and line and ini:section_exist(section) and ini:line_exist(section, line) then
		if     var_type == "bool"   then return ini:r_bool(section, line)
		elseif var_type == "string" then return ini:r_string(section, line)
		elseif var_type == "float"  then return ini:r_float(section, line)
		else                             return ini:r_string_wq(section, line)
		end
	end
	return default
end

function trim(s)
	return string.gsub(s, "^%s*(.-)%s*$", "%1")
end

function string:split(pat)
	local st, g = 1, self:gmatch("()(" .. pat .. ")")
	local function getter(self, segs, seps, sep, cap1, ...)
		st = sep and seps + #sep
		return self:sub(segs, (seps or 0) - 1), cap1 or sep, ...
	end
	local function splitter(self)
		if st then return getter(self, st, g()) end
	end
	return splitter, self
end

function str_explode(str, pattern)
	if type(str) ~= "string" then return {} end
	local t = {}
	for word, pat, start in str:split(pattern) do
		t[#t + 1] = trim(word)
		if start and pat == pattern then
			t[#t + 1] = trim(str:sub(start))
			break
		end
	end
	return t
end

function parse_list(ini, key, val, convert)
	local str = read_from_ini(ini, key, val, "string", "")
	local t = str_explode(str, ",")
	if convert and #t > 0 then
		local l = {}
		for _, v in ipairs(t) do l[v] = true end
		return l
	end
	return t
end

------------------------------------------------------
-- Ранги NPC
------------------------------------------------------

local ranks
function get_rank_list()
	if ranks then return ranks end
	local tmp = parse_list(nil, "game_relations", "rating")
	ranks = {}
	for _, rn in ipairs(tmp) do
		if not tonumber(rn) then table.insert(ranks, rn) end
	end
	return ranks
end

------------------------------------------------------
-- Утилиты
------------------------------------------------------

function rand_num(a, b)
	if a and b then return math.random(a, b) end
	return math.random()
end

function is_in_same_squad(npc1, npc2)
	if not (npc1 and npc2) then return false end
	local sq1 = get_object_squad(npc1)
	local sq2 = get_object_squad(npc2)
	return sq1 and sq2 and sq1.id == sq2.id
end

