function set_weapon_drop_condition(item, npc_rank)
	local roll_the_dice = math.random(100)
	local condition_val
	
	if npc_rank == nil then
		npc_rank = 100
	end
	
	if npc_rank < 200 then --					Новичок или зомби: оружие уничтожено, ржавый хлам
		if roll_the_dice <= 95 then
			condition_val = math.random(4, 15) -- 95% шанс: металлолом, только на запчасти
		else
			condition_val = math.random(16, 28) -- 5% шанс: критический износ, стрелять нельзя
		end
		
	elseif npc_rank < 400 then --					Обычный: сильно изношенные стволы
		if roll_the_dice <= 85 then
			condition_val = math.random(8, 22) -- 85% шанс: состояние «убитое»
		elseif roll_the_dice <= 97 then
			condition_val = math.random(23, 38) -- 12% шанс: частые клины при стрельбе
		else 
			condition_val = math.random(39, 52) -- 3% шанс: среднее состояние, повезло найти
		end
		
	elseif npc_rank < 600 then --				Опытный / Ветеран: оружие повидало виды
		if roll_the_dice <= 75 then
			condition_val = math.random(12, 28) -- 75% шанс: плохой износ
		elseif roll_the_dice <= 92 then
			condition_val = math.random(29, 45) -- 17% шанс: рабочее, но требует ремонта
		else
			condition_val = math.random(46, 65) -- 8% шанс: относительно неплохое состояние
		end
		
	else --										Мастер / Элита: следят за стволами, но палить приходится много
		if roll_the_dice <= 70 then
			condition_val = math.random(18, 35) -- 70% шанс: изношено в боях за выживание
		elseif roll_the_dice <= 90 then
			condition_val = math.random(36, 55) -- 20% шанс: хорошее состояние для Зоны
		else
			condition_val = math.random(56, 75) -- 10% шанс: ценный трофей (75% — потолок для MISERY)
		end
	end
	
	item:set_condition(condition_val / 100)
	item:sync_condition() -- update after condition change
end


--' Функция спавнит необходимое число предметов
function create_items(npc, section, number, rnd)
		--'printf("create %s of %s", tostring(number), tostring(section))
		if ammo_sections[section] == true then
				if number > 0 then
					create_ammo(section,
						npc:position(),
						npc:level_vertex_id(),
						npc:game_vertex_id(),
						npc:id(),
										number)
				end
		else
				for i=1,number do
			--' Проверяем вероятность появить каждый объект в отдельности
					if math.random(100) <=  rnd then
					alife():create(section,
							npc:position(),
						npc:level_vertex_id(),
						npc:game_vertex_id(),
						npc:id())
			end
				end
		end
end


--' Функция проверяет есть ли хоть один из зависимых объектов у персонажа
function check_item_dependence(npc, section)
	if item_dependence[section] == nil then
		return true
	end

		local d_flag = true
		for k,v in pairs(item_dependence[section]) do
				local obj = npc:object(k)
				if obj ~= nil and npc:marked_dropped(obj) ~= true then
						return true
				end
				d_flag = false
		end

		return d_flag
end