--------------------------------------------------------------------------------
-- Modified by Alundaio for AI Tweaks 2.1.0+
-- Ported to xrMPE (X-Ray Multiplayer Extension) by addon
--
-- XRMPE NOTES:
--   * CAtmosFear is a pure data/logic object - no UI, no direct bind_stalker
--     dependency.  It is created lazily via get_atmosfear() and stored in
--     a module-local variable so every caller shares the same instance.
--   * Callbacks are registered in on_game_start() which xrMPE calls for every
--     loaded script module.
--   * actor_on_save / actor_on_load are registered here so the AF state
--     (weather options chosen in the menu) survives save/load cycles.
--   * Drug-protection check runs in actor_on_update which fires every frame
--     on both server and client (we guard with OnClient check in the method).
--   * loadDefaultConsoleSettings() uses xrMPE-compatible render commands.
--------------------------------------------------------------------------------

local atmosfear = nil

-- ============================================================
--  Script entry point (called by xrMPE for every .script file)
-- ============================================================
function on_game_start()
    callback_register("actor_on_init",      actor_on_init)
    callback_register("actor_on_update",    actor_on_update)
    callback_register("actor_on_item_use",  actor_on_item_use)
    callback_register("actor_on_save",      actor_on_save)
    callback_register("actor_on_load",      actor_on_load)
end

-- ============================================================
--  Callbacks
-- ============================================================
function actor_on_init(se_actor)
    -- Eagerly create the CAtmosFear instance so other modules
    -- (level_weathers, surge_manager, atmosfear_options) can call
    -- get_atmosfear() immediately after actor_on_init fires.
    se_actor.atmosfear = get_atmosfear()
end

function actor_on_update(se_actor)
    -- Drug-protection expiry check is client-only (uses db.actor directly).
    if not OnClient() then return end
    if se_actor.atmosfear then
        se_actor.atmosfear:update()
    end
    -- One-time console setup after the actor is fully loaded.
    if not db.actor:has_info("atmosfear_default_console_settings_loaded") then
        se_actor.atmosfear:loadDefaultConsoleSettings()
        db.actor:give_info_portion("atmosfear_default_console_settings_loaded")
    end
end

function actor_on_item_use(item)
    local sec = item:section()
    local drug = {
        ["drug_psy_blockade"]   = true,
        ["drug_radioprotector"] = true,
        ["drug_antidot"]        = true,
    }
    if sec and drug[sec] then
        local boost_time = system_ini():r_float(sec, "boost_time")
        xr_logic.pstor_store(
            db.actor, sec .. "_expiration",
            CTimeAddSec(game.get_game_time(), boost_time * level.get_time_factor())
        )
    end
end

function actor_on_save(se_actor, packet)
    if se_actor.atmosfear then
        se_actor.atmosfear:save(packet)
    end
end

function actor_on_load(se_actor, reader)
    if se_actor.atmosfear then
        se_actor.atmosfear:load(reader)
    end
end

-- ============================================================
--  CAtmosFear class
-- ============================================================
class "CAtmosFear"

function CAtmosFear:__init()
    self.aspectRatio = 1
    if device().width / device().height > (1024 / 768 + 0.01) then
        self.aspectRatio = 0.8
    end
    self.param_ini = ini_file("atmosfear_parameters.ltx")
    self:loadDefaultParameters()
end

-- Called by level_weathers / surge_manager after the object already exists;
-- kept for API compatibility but nothing to do here.
function CAtmosFear:initialize()
end

-- --------------------------------------------------------
--  Per-frame update - drug protection expiry
--  (runs on client only, guarded by the caller)
-- --------------------------------------------------------
function CAtmosFear:update()
    local g_time = CTimeToSec(game.get_game_time())

    -- PSI / telepatic protection
    local exp = xr_logic.pstor_retrieve(db.actor, "drug_psy_blockade_expiration")
    if exp ~= nil then
        if g_time < exp then
            self.drug_telepatic_protection = system_ini():r_float("drug_psy_blockade", "boost_telepat_protection")
        else
            self.drug_telepatic_protection = nil
        end
    end

    -- Radiation protection
    exp = xr_logic.pstor_retrieve(db.actor, "drug_radioprotector_expiration")
    if exp ~= nil then
        if g_time < exp then
            self.drug_radiation_protection = system_ini():r_float("drug_radioprotector", "boost_radiation_protection")
        else
            self.drug_radiation_protection = nil
        end
    end

    -- Chemical burn protection
    exp = xr_logic.pstor_retrieve(db.actor, "drug_antidot_expiration")
    if exp ~= nil then
        if g_time < exp then
            self.drug_chemical_burn_protection = system_ini():r_float("drug_antidot", "boost_chemburn_protection")
        else
            self.drug_chemical_burn_protection = nil
        end
    end
end

-- --------------------------------------------------------
--  Damage mitigation helper (used by surge/psi-storm hits)
-- --------------------------------------------------------
function CAtmosFear:hit_power(power, hit_type)
    -- hit_type: 0=burn 1=shock 2=chemical_burn 3=radiation 4=telepatic
    local suit_factors   = {10, 1, 5, 33, 10}
    local hit_types      = {"burn", "shock", "chemical_burn", "radiation", "telepatic"}

    local suit_protection = db.actor:get_current_outfit_protection(hit_type) * suit_factors[hit_type + 1]

    local helmet_protection = 0
    local helmet = db.actor:item_in_slot(12)
    if helmet ~= nil then
        helmet_protection =
            system_ini():r_float(helmet:section(), hit_types[hit_type + 1] .. "_protection") *
            suit_factors[hit_type + 1]
    end

    local drug_protection = 0
    if hit_type == 2 and self.drug_chemical_burn_protection ~= nil then
        drug_protection = self.drug_chemical_burn_protection * 5
    elseif hit_type == 3 and self.drug_radiation_protection ~= nil then
        drug_protection = self.drug_radiation_protection * 33
    elseif hit_type == 4 and self.drug_telepatic_protection ~= nil then
        drug_protection = self.drug_telepatic_protection * 10
    end

    local protection = suit_protection + helmet_protection + drug_protection
    if protection > 1 then protection = 1 end

    return power * (1 - protection)
end

-- --------------------------------------------------------
--  Serialisation
-- --------------------------------------------------------
function CAtmosFear:save(packet)
    set_save_marker(packet, "save", false, "AtmosFear")
    packet:w_stringZ(self.opt_weather_balance_presets)
    packet:w_stringZ(self.opt_weather_length_presets)
    packet:w_stringZ(self.opt_zaton_period_good)
    packet:w_stringZ(self.opt_zaton_period_bad)
    packet:w_u32(self.opt_zaton_period_good_length)
    packet:w_u32(self.opt_zaton_period_bad_length)
    packet:w_stringZ(self.opt_jupiter_period_good)
    packet:w_stringZ(self.opt_jupiter_period_bad)
    packet:w_u32(self.opt_jupiter_period_good_length)
    packet:w_u32(self.opt_jupiter_period_bad_length)
    packet:w_stringZ(self.opt_pripyat_period_good)
    packet:w_stringZ(self.opt_pripyat_period_bad)
    packet:w_u32(self.opt_pripyat_period_good_length)
    packet:w_u32(self.opt_pripyat_period_bad_length)
    packet:w_u32(self.opt_enable_blowout)
    packet:w_u32(self.opt_blowout_freq)
    packet:w_stringZ(self.opt_blowout_fate)
    packet:w_stringZ(self.opt_blowout_warning)
    packet:w_stringZ(self.opt_blowout_task)
    packet:w_u32(self.opt_enable_fallout)
    packet:w_u32(self.opt_fallout_freq)
    packet:w_stringZ(self.opt_fallout_fate)
    packet:w_stringZ(self.opt_fallout_warning)
    packet:w_stringZ(self.opt_fallout_task)
    packet:w_u32(self.opt_enable_psi_storm)
    packet:w_u32(self.opt_psi_storm_freq)
    packet:w_stringZ(self.opt_psi_storm_fate)
    packet:w_stringZ(self.opt_psi_storm_warning)
    packet:w_stringZ(self.opt_psi_storm_task)
    packet:w_stringZ(self.opt_moon_phase)
    packet:w_stringZ(self.opt_night_brightness)
    set_save_marker(packet, "save", true, "AtmosFear")
end

function CAtmosFear:load(reader)
    set_save_marker(reader, "load", false, "AtmosFear")
    self.opt_weather_balance_presets    = reader:r_stringZ()
    self.opt_weather_length_presets     = reader:r_stringZ()
    self.opt_zaton_period_good          = reader:r_stringZ()
    self.opt_zaton_period_bad           = reader:r_stringZ()
    self.opt_zaton_period_good_length   = reader:r_u32()
    self.opt_zaton_period_bad_length    = reader:r_u32()
    self.opt_jupiter_period_good        = reader:r_stringZ()
    self.opt_jupiter_period_bad         = reader:r_stringZ()
    self.opt_jupiter_period_good_length = reader:r_u32()
    self.opt_jupiter_period_bad_length  = reader:r_u32()
    self.opt_pripyat_period_good        = reader:r_stringZ()
    self.opt_pripyat_period_bad         = reader:r_stringZ()
    self.opt_pripyat_period_good_length = reader:r_u32()
    self.opt_pripyat_period_bad_length  = reader:r_u32()
    self.opt_enable_blowout             = reader:r_u32()
    self.opt_blowout_freq               = reader:r_u32()
    self.opt_blowout_fate               = reader:r_stringZ()
    self.opt_blowout_warning            = reader:r_stringZ()
    self.opt_blowout_task               = reader:r_stringZ()
    self.opt_enable_fallout             = reader:r_u32()
    self.opt_fallout_freq               = reader:r_u32()
    self.opt_fallout_fate               = reader:r_stringZ()
    self.opt_fallout_warning            = reader:r_stringZ()
    self.opt_fallout_task               = reader:r_stringZ()
    self.opt_enable_psi_storm           = reader:r_u32()
    self.opt_psi_storm_freq             = reader:r_u32()
    self.opt_psi_storm_fate             = reader:r_stringZ()
    self.opt_psi_storm_warning          = reader:r_stringZ()
    self.opt_psi_storm_task             = reader:r_stringZ()
    self.opt_moon_phase                 = reader:r_stringZ()
    self.opt_night_brightness           = reader:r_stringZ()
    set_save_marker(reader, "load", true, "AtmosFear")
end

-- --------------------------------------------------------
--  Load defaults from atmosfear_parameters.ltx
-- --------------------------------------------------------
function CAtmosFear:loadDefaultParameters()
    local p = xr_s.parse_ini_section_to_array(self.param_ini, "atmosfear_default_parameters")

    self.opt_weather_balance_presets    = p["opt_weather_balance_presets"]
    self.opt_weather_length_presets     = p["opt_weather_length_presets"]

    self.opt_zaton_period_good          = p["opt_zaton_period_good"]
    self.opt_zaton_period_bad           = p["opt_zaton_period_bad"]
    self.opt_zaton_period_good_length   = tonumber(p["opt_zaton_period_good_length"])
    self.opt_zaton_period_bad_length    = tonumber(p["opt_zaton_period_bad_length"])
    self.opt_jupiter_period_good        = p["opt_jupiter_period_good"]
    self.opt_jupiter_period_bad         = p["opt_jupiter_period_bad"]
    self.opt_jupiter_period_good_length = tonumber(p["opt_jupiter_period_good_length"])
    self.opt_jupiter_period_bad_length  = tonumber(p["opt_jupiter_period_bad_length"])
    self.opt_pripyat_period_good        = p["opt_pripyat_period_good"]
    self.opt_pripyat_period_bad         = p["opt_pripyat_period_bad"]
    self.opt_pripyat_period_good_length = tonumber(p["opt_pripyat_period_good_length"])
    self.opt_pripyat_period_bad_length  = tonumber(p["opt_pripyat_period_bad_length"])

    self.opt_enable_blowout             = tonumber(p["opt_enable_blowout"])
    self.opt_blowout_freq               = tonumber(p["opt_blowout_freq"])
    self.opt_blowout_fate               = p["opt_blowout_fate"]
    self.opt_blowout_warning            = p["opt_blowout_warning"]
    self.opt_blowout_task               = p["opt_blowout_task"]
    self.opt_enable_fallout             = tonumber(p["opt_enable_fallout"])
    self.opt_fallout_freq               = tonumber(p["opt_fallout_freq"])
    self.opt_fallout_fate               = p["opt_fallout_fate"]
    self.opt_fallout_warning            = p["opt_fallout_warning"]
    self.opt_fallout_task               = p["opt_fallout_task"]
    self.opt_enable_psi_storm           = tonumber(p["opt_enable_psi_storm"])
    self.opt_psi_storm_freq             = tonumber(p["opt_psi_storm_freq"])
    self.opt_psi_storm_fate             = p["opt_psi_storm_fate"]
    self.opt_psi_storm_warning          = p["opt_psi_storm_warning"]
    self.opt_psi_storm_task             = p["opt_psi_storm_task"]

    self.opt_moon_phase                 = p["opt_moon_phase"]
    self.opt_night_brightness           = p["opt_night_brightness"]

    self.god_mode                       = str_to_bool(p["opt_god_mode"])
end

-- --------------------------------------------------------
--  One-time r2 console setup (applied once per new game)
--  Tuned for xrMPE / CoP renderer.  Adjust to taste.
-- --------------------------------------------------------
function CAtmosFear:loadDefaultConsoleSettings()
    local c = get_console()
    c:execute("r2_dof_far 800")
    c:execute("r2_allow_r1_lights off")
    c:execute("r2_dof -0.400000,1.400000,500.000000")
    c:execute("r2_dof_enable on")
    c:execute("r2_dof_kernel 2.")
    c:execute("r2_dof_sky 0.")
    c:execute("r2_exp_donttest_shad off")
    c:execute("r2_gi off")
    c:execute("r2_ls_bloom_fast off")
    c:execute("r2_sun on")
    c:execute("r2_sun_depth_far_bias -0.00002")
    c:execute("r2_sun_depth_far_scale 1.")
    c:execute("r2_sun_depth_near_bias 0.00007")
    c:execute("r2_sun_depth_near_scale 1.")
    c:execute("r2_sun_details on")
    c:execute("r2_sun_far 180.")
    c:execute("r2_sun_focus on")
    c:execute("r2_sun_lumscale 1.")
    c:execute("r2_sun_lumscale_amb 0.1")
    c:execute("r2_sun_lumscale_hemi 0.6")
    c:execute("r2_sun_near 30.")
    c:execute("r2_sun_near_border 0.75")
    c:execute("r2_sun_tsm on")
    c:execute("r2_sun_tsm_bias -0.01")
    c:execute("r2_sun_tsm_proj 0.3")
    c:execute("r2_tf_mipbias 0.")
    c:execute("r2_tonemap on")
    c:execute("r2_tonemap_adaptation 0.2")
    c:execute("r2_tonemap_amount 1.")
    c:execute("r2_tonemap_lowlum 0.4")
    c:execute("r2_tonemap_middlegray 1.1")
    c:execute("rs_c_brightness 1.")
    c:execute("rs_c_contrast 1.")
    c:execute("rs_c_gamma 1.")
end

-- ============================================================
--  Utilities
-- ============================================================
function str_to_bool(str)
    if str == "true"  then return true  end
    if str == "false" then return false end
    return nil
end

function CTimeToSec(ctime)
    local Y, M, D, h, m, s, ms = 0, 0, 0, 0, 0, 0, 0
    Y, M, D, h, m, s, ms = ctime:get(Y, M, D, h, m, s, ms)
    return D * 86400 + h * 3600 + m * 60 + s
end

function CTimeAddSec(ctime, sec)
    return CTimeToSec(ctime) + sec
end

-- ============================================================
--  Singleton accessor
-- ============================================================
function get_atmosfear()
    if atmosfear == nil then
        atmosfear = CAtmosFear()
    end
    return atmosfear
end
