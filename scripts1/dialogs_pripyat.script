function pri_a25_medic_give_kit(first_speaker, second_speaker)
	local kit = "basic"

	if story_flags.has_flag("PRI_A25_ACTOR_NEEDS_MEDIKIT_ADVANCED_SUPPLY") then
		kit = "advanced"
	elseif story_flags.has_flag("PRI_A25_ACTOR_NEEDS_MEDIKIT_ELITE_SUPPLY") then
		kit = "elite"
	end

	for k,v in pairs(medic_items_table) do
		if k == kit then
			for kk,vv in pairs(v) do
				dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, kk, vv)
			end
			story_flags.disable_flag(k)
		end
	end
end

